---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  current?: 'home' | 'docs'
  markdownUrl?: string
  ogType?: 'website' | 'article'
  jsonLd?: Record<string, unknown>[]
}

const {
  title,
  description = 'Documentation for the devmachine CLI.',
  current = 'home',
  markdownUrl,
  ogType = 'website',
  jsonLd = [],
} = Astro.props
const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL(`${base}og.png`, Astro.site).href
// Doc pages lay out wider than the home page; the header lines up with them.
const frame = current === 'docs' ? 'max-w-7xl' : 'max-w-6xl'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="devmachine" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="devmachine — Code from anywhere." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('devmachine-theme')
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved)
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header
      class:list={[
        'z-40',
        current === 'home' ? 'absolute top-0 inset-x-0 bg-transparent' : 'border-b hairline sticky top-0 bg-[var(--bg)]',
      ]}
    >
      <div class={`${frame} mx-auto px-4 sm:px-6 h-16 flex items-center justify-between`}>
        <a href={`${base}`} class="flex items-center gap-2 font-semibold tracking-tight text-xl">
          <img src={`${base}favicon.svg`} alt="" width="26" height="26" class="block" />
          devmachine
        </a>
        <div class="flex items-center gap-2">
          <nav class="hidden md:flex items-center gap-1 text-sm">
            <a href={`${base}getting-started/`} class="px-3 py-1.5">Documentation</a>
            <a
              href="https://github.com/mydevmachine/devmachine"
              class="px-3 py-1.5"
              target="_blank"
              rel="noreferrer"
            >
              GitHub
            </a>
          </nav>
          <button
            id="mobile-nav-toggle"
            type="button"
            class="md:hidden text-xs font-mono uppercase tracking-wide px-3 py-1.5 border hairline"
          >
            Menu
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="hidden md:hidden border-t hairline px-4 py-3 flex flex-col gap-2 text-sm bg-[var(--bg)]">
        <a href={`${base}getting-started/`}>Documentation</a>
        <a href="https://github.com/mydevmachine/devmachine" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main class="flex-1 min-w-0">
      <slot />
    </main>
    <footer class="border-t hairline mt-12">
      <div class={`${frame} mx-auto px-4 sm:px-6 py-8 flex items-start justify-between gap-4`}>
        <div class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-[var(--muted)] min-w-0">
          <a href={`${base}examples/`}>Real examples</a>
          <a href={`${base}getting-started/`}>Documentation</a>
          <a href="https://github.com/mydevmachine/devmachine" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://github.com/mydevmachine/devmachine/blob/main/LICENSE" target="_blank" rel="noreferrer">License</a>
          <a href={`${base}llms.txt`}>llms.txt</a>
          <a href={`${base}llms-full.txt`}>llms-full.txt</a>
        </div>
        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle inline-flex items-center justify-center w-8 h-8 border hairline shrink-0"
          aria-label="Switch between light and dark"
          title="Light / dark"
        >
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </footer>
    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle')
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement
        const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
        const next = current === 'dark' ? 'light' : 'dark'
        root.setAttribute('data-theme', next)
        try {
          localStorage.setItem('devmachine-theme', next)
        } catch {}
      })

      const mobileToggle = document.getElementById('mobile-nav-toggle')
      const mobileNav = document.getElementById('mobile-nav')
      mobileToggle?.addEventListener('click', () => {
        mobileNav?.classList.toggle('hidden')
      })

      document.querySelectorAll('pre').forEach((pre) => {
        if (pre.querySelector('.copy-btn')) return

        const scrollWrap = document.createElement('div')
        scrollWrap.className = 'pre-scroll'
        while (pre.firstChild) scrollWrap.appendChild(pre.firstChild)
        pre.appendChild(scrollWrap)

        const btn = document.createElement('button')
        btn.className = 'copy-btn'
        btn.type = 'button'
        btn.textContent = 'Copy'
        btn.addEventListener('click', () => {
          const code = scrollWrap.querySelector('code')?.textContent ?? scrollWrap.textContent ?? ''
          navigator.clipboard?.writeText(code.trim())
          btn.textContent = 'Copied'
          setTimeout(() => {
            btn.textContent = 'Copy'
          }, 1500)
        })
        pre.appendChild(btn)
      })
    </script>
  </body>
</html>
