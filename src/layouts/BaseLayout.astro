---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  current?: 'home' | 'docs'
}

const { title, description = 'Documentation for the devmachine CLI.', current = 'home' } = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('devmachine-theme')
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved)
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b hairline sticky top-0 z-40 bg-[var(--bg)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href={`${base}`} class="font-extrabold tracking-tight text-lg">devmachine</a>
        <nav class="hidden md:flex items-center gap-1 text-sm">
          <a
            href={`${base}`}
            class:list={['px-3 py-1.5 rounded-full', current === 'docs' && 'border hairline']}
          >
            Docs
          </a>
          <a href={`${base}getting-started/`} class="px-3 py-1.5 rounded-full">Getting started</a>
          <a href={`${base}reference/commands/`} class="px-3 py-1.5 rounded-full">Reference</a>
          <a
            href="https://github.com/adevmachine/cli"
            class="px-3 py-1.5 rounded-full"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </nav>
        <div class="flex items-center gap-2">
          <button
            id="theme-toggle"
            type="button"
            class="text-xs font-mono uppercase tracking-wide px-3 py-1.5 rounded-full border hairline"
            aria-label="Toggle dark mode"
          >
            OLED dark
          </button>
          <button
            id="mobile-nav-toggle"
            type="button"
            class="md:hidden text-xs font-mono uppercase tracking-wide px-3 py-1.5 rounded-full border hairline"
          >
            Menu
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="hidden md:hidden border-t hairline px-4 py-3 flex flex-col gap-2 text-sm">
        <a href={`${base}`}>Docs</a>
        <a href={`${base}getting-started/`}>Getting started</a>
        <a href={`${base}reference/commands/`}>Reference</a>
        <a href="https://github.com/adevmachine/cli" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t hairline mt-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-wrap gap-x-8 gap-y-2 text-sm text-[var(--muted)]">
        <a href="https://github.com/adevmachine/cli" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://github.com/adevmachine/cli/blob/main/LICENSE" target="_blank" rel="noreferrer">License</a>
        <a href={`${base}llms.txt`}>llms.txt</a>
      </div>
    </footer>
    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle')
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement
        const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
        const next = current === 'dark' ? 'light' : 'dark'
        root.setAttribute('data-theme', next)
        try {
          localStorage.setItem('devmachine-theme', next)
        } catch {}
      })

      const mobileToggle = document.getElementById('mobile-nav-toggle')
      const mobileNav = document.getElementById('mobile-nav')
      mobileToggle?.addEventListener('click', () => {
        mobileNav?.classList.toggle('hidden')
      })

      document.querySelectorAll('pre').forEach((pre) => {
        if (pre.querySelector('.copy-btn')) return

        const scrollWrap = document.createElement('div')
        scrollWrap.className = 'pre-scroll'
        while (pre.firstChild) scrollWrap.appendChild(pre.firstChild)
        pre.appendChild(scrollWrap)

        const btn = document.createElement('button')
        btn.className = 'copy-btn'
        btn.type = 'button'
        btn.textContent = 'Copy'
        btn.addEventListener('click', () => {
          const code = scrollWrap.querySelector('code')?.textContent ?? scrollWrap.textContent ?? ''
          navigator.clipboard?.writeText(code.trim())
          btn.textContent = 'Copied'
          setTimeout(() => {
            btn.textContent = 'Copy'
          }, 1500)
        })
        pre.appendChild(btn)
      })
    </script>
  </body>
</html>
