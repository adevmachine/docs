---
interface Props {
  eyebrow: string
  headline: string
  subline: string
}

const { eyebrow, headline, subline } = Astro.props
---

<section class="pipes-hero" id="pipes-hero">
  <div class="pipes-grid frame">
    <div class="pipes-copy">
      <p class="hero-eyebrow text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-4">
        <span class="hero-eyebrow-dot"></span>
        {eyebrow}
      </p>
      <h1 class="text-5xl sm:text-6xl font-light leading-[0.95] tracking-tight" style="letter-spacing: -0.03em;">
        {headline}
      </h1>
      <p class="hero-subline text-base sm:text-lg text-[var(--muted)] mt-5 max-w-md">
        {subline}
      </p>

      <div class="border hairline bg-[var(--card)] p-4 sm:p-5 mt-8 max-w-md relative font-mono text-sm">
        <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">Install and set up</p>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <code id="pipes-install-cmd" class="min-w-0 break-all leading-relaxed"
            >curl -fsSL https://mydevmachine.sh/install.sh | sh<br />devmachine setup</code
          >
          <button
            id="pipes-install-copy"
            type="button"
            class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
          >
            Copy
          </button>
        </div>
        <p class="text-xs text-[var(--muted)] mt-2">
          Or with Homebrew: <code class="font-mono">brew install mydevmachine/tap/devmachine</code>
        </p>
      </div>
    </div>

    <div class="pipes-scene-wrap">
      <svg
        id="pipes-svg"
        class="pipes-svg"
        viewBox="0 0 640 520"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Diagram: your computer connects to a server, which runs three workspaces, one of which talks to a phone."
      >
        <defs>
          <marker id="pipes-packet" markerWidth="8" markerHeight="8" refX="4" refY="4">
            <rect x="0" y="0" width="8" height="8" class="pipe-packet-shape"></rect>
          </marker>
        </defs>

        <g class="pipe-lines" fill="none" stroke-width="2">
          <path id="pipe-computer-server" class="pipe-line" d="M 120 120 H 170 V 210 H 260"></path>
          <path id="pipe-server-acme" class="pipe-line" d="M 330 250 H 300 V 280 H 330"></path>
          <path id="pipe-server-bob" class="pipe-line" d="M 330 330 H 300 V 360 H 330"></path>
          <path id="pipe-server-agent" class="pipe-line" d="M 330 410 H 300 V 440 H 330"></path>
          <path id="pipe-phone-acme" class="pipe-line" d="M 520 300 H 570 V 200 H 610"></path>
        </g>

        <g class="pipe-flow" fill="none" stroke-width="2">
          <path id="flow-computer-server" class="pipe-flow-path" d="M 120 120 H 170 V 210 H 260"></path>
          <path id="flow-phone-acme" class="pipe-flow-path" d="M 520 300 H 570 V 200 H 610"></path>
        </g>

        <rect id="packet-computer-server" class="pipe-packet" width="7" height="7" x="-4" y="-4"></rect>
        <rect id="packet-phone-acme" class="pipe-packet" width="7" height="7" x="-4" y="-4"></rect>

        <g id="win-computer" class="pipes-window" transform="translate(10,40)">
          <rect class="win-frame" width="220" height="90" x="0" y="0"></rect>
          <g class="win-titlebar">
            <rect width="220" height="22" x="0" y="0"></rect>
            <circle class="win-dot" cx="12" cy="11" r="2.5"></circle>
            <circle class="win-dot" cx="22" cy="11" r="2.5"></circle>
            <circle class="win-dot" cx="32" cy="11" r="2.5"></circle>
            <text class="win-label" x="110" y="15" text-anchor="middle">your computer</text>
          </g>
          <g class="win-dashed-grid">
            <line x1="0" y1="56" x2="220" y2="56"></line>
            <line x1="73" y1="22" x2="73" y2="90"></line>
            <line x1="146" y1="22" x2="146" y2="90"></line>
          </g>
          <text class="win-mono" x="12" y="76">
            <tspan class="win-prompt">$</tspan> devmachine sync<tspan id="computer-cursor" class="win-cursor">_</tspan>
          </text>
        </g>

        <g id="win-server" class="pipes-window" transform="translate(260,110)">
          <rect class="win-frame" width="260" height="340" x="0" y="0"></rect>
          <g class="win-titlebar">
            <rect width="260" height="22" x="0" y="0"></rect>
            <circle class="win-dot" cx="12" cy="11" r="2.5"></circle>
            <circle class="win-dot" cx="22" cy="11" r="2.5"></circle>
            <circle class="win-dot" cx="32" cy="11" r="2.5"></circle>
            <text class="win-label" x="130" y="15" text-anchor="middle">main · 203.0.113.10</text>
          </g>
          <g class="win-dashed-grid">
            <line x1="0" y1="181" x2="260" y2="181"></line>
            <line x1="87" y1="22" x2="87" y2="340"></line>
            <line x1="173" y1="22" x2="173" y2="340"></line>
          </g>

          <g id="win-acme" class="pipes-window pipes-window-inner" transform="translate(30,40)">
            <rect class="win-frame" width="200" height="50" x="0" y="0"></rect>
            <g class="win-titlebar">
              <rect width="200" height="18" x="0" y="0"></rect>
              <circle class="win-dot win-dot-sm" cx="10" cy="9" r="2"></circle>
              <circle class="win-dot win-dot-sm" cx="18" cy="9" r="2"></circle>
              <circle class="win-dot win-dot-sm" cx="26" cy="9" r="2"></circle>
              <text class="win-label win-label-sm" x="100" y="12.5" text-anchor="middle">acme</text>
            </g>
            <text id="acme-line" class="win-mono win-mono-sm" x="10" y="38">~/app $ npm run dev</text>
          </g>

          <g id="win-bob" class="pipes-window pipes-window-inner" transform="translate(30,120)">
            <rect class="win-frame" width="200" height="50" x="0" y="0"></rect>
            <g class="win-titlebar">
              <rect width="200" height="18" x="0" y="0"></rect>
              <circle class="win-dot win-dot-sm" cx="10" cy="9" r="2"></circle>
              <circle class="win-dot win-dot-sm" cx="18" cy="9" r="2"></circle>
              <circle class="win-dot win-dot-sm" cx="26" cy="9" r="2"></circle>
              <text class="win-label win-label-sm" x="100" y="12.5" text-anchor="middle">bob</text>
            </g>
            <text id="bob-line" class="win-mono win-mono-sm" x="10" y="38">$ docker ps</text>
          </g>

          <g id="win-agent" class="pipes-window pipes-window-inner" transform="translate(30,200)">
            <rect class="win-frame" width="200" height="50" x="0" y="0"></rect>
            <g class="win-titlebar">
              <rect width="200" height="18" x="0" y="0"></rect>
              <circle class="win-dot win-dot-sm" cx="10" cy="9" r="2"></circle>
              <circle class="win-dot win-dot-sm" cx="18" cy="9" r="2"></circle>
              <circle class="win-dot win-dot-sm" cx="26" cy="9" r="2"></circle>
              <text class="win-label win-label-sm" x="100" y="12.5" text-anchor="middle">agent</text>
            </g>
            <text id="agent-line" class="win-mono win-mono-sm" x="10" y="38">openclaw running</text>
          </g>
        </g>

        <g id="win-phone" class="pipes-window" transform="translate(560,170)">
          <rect class="win-frame" width="70" height="260" x="0" y="0"></rect>
          <g class="win-titlebar">
            <rect width="70" height="20" x="0" y="0"></rect>
            <circle class="win-dot win-dot-sm" cx="10" cy="10" r="2"></circle>
            <circle class="win-dot win-dot-sm" cx="18" cy="10" r="2"></circle>
            <circle class="win-dot win-dot-sm" cx="26" cy="10" r="2"></circle>
          </g>
          <text class="win-label win-label-sm" x="35" y="35" text-anchor="middle">phone</text>
          <g class="win-dashed-grid">
            <line x1="0" y1="130" x2="70" y2="130"></line>
          </g>
          <rect class="phone-card" x="8" y="55" width="54" height="60" rx="0"></rect>
          <text class="win-mono-sm phone-card-text" x="12" y="75">acme ·</text>
          <text class="win-mono-sm phone-card-text" x="12" y="87">Claude Code</text>
          <text id="phone-status" class="win-mono-sm phone-status" x="12" y="103">online</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<script is:inline>
  ;(() => {
    const section = document.getElementById('pipes-hero')
    if (!(section instanceof HTMLElement)) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const svg = document.getElementById('pipes-svg')
    const flowPaths = Array.from(document.querySelectorAll('.pipe-flow-path'))
    const packets = {
      'computer-server': document.getElementById('packet-computer-server'),
      'phone-acme': document.getElementById('packet-phone-acme'),
    }
    const flowPathEls = {
      'computer-server': document.getElementById('flow-computer-server'),
      'phone-acme': document.getElementById('flow-phone-acme'),
    }
    const workspaceWindows = {
      acme: document.getElementById('win-acme'),
      bob: document.getElementById('win-bob'),
      agent: document.getElementById('win-agent'),
    }
    const workspaceLines = {
      acme: document.getElementById('acme-line'),
      bob: document.getElementById('bob-line'),
      agent: document.getElementById('agent-line'),
    }
    const commandFlavors = {
      acme: '~/app $ npm run dev',
      bob: 'docker ps',
      agent: 'openclaw running',
    }

    if (reduceMotion) {
      section.classList.add('pipes-static')
      return
    }

    let running = false
    let rafId = null
    let lastTime = 0
    let pulseTimer = null

    function pathLength(el) {
      return el instanceof SVGPathElement ? el.getTotalLength() : 0
    }

    const lengths = {
      'computer-server': pathLength(flowPathEls['computer-server']),
      'phone-acme': pathLength(flowPathEls['phone-acme']),
    }

    function placePacket(key, t) {
      const path = flowPathEls[key]
      const packet = packets[key]
      if (!(path instanceof SVGPathElement) || !packet) return
      const len = lengths[key]
      if (!len) return
      const pos = path.getPointAtLength((t % 1) * len)
      packet.setAttribute('transform', `translate(${pos.x}, ${pos.y})`)
    }

    function tick(time) {
      if (!running) return
      const dt = lastTime ? time - lastTime : 0
      lastTime = time
      const speed = 0.00025
      const tComputer = (time * speed) % 1
      const tPhone = (time * speed * 0.8) % 1
      placePacket('computer-server', tComputer)
      placePacket('phone-acme', tPhone)
      rafId = requestAnimationFrame(tick)
    }

    function startRaf() {
      if (rafId != null) return
      lastTime = 0
      rafId = requestAnimationFrame(tick)
    }

    function stopRaf() {
      if (rafId != null) cancelAnimationFrame(rafId)
      rafId = null
    }

    function pulseWorkspace() {
      const keys = Object.keys(workspaceWindows)
      const key = keys[Math.floor(Math.random() * keys.length)]
      const win = workspaceWindows[key]
      const line = workspaceLines[key]
      if (!win || !line) return
      win.classList.add('pipes-pulse')
      const original = commandFlavors[key]
      line.textContent = key === 'acme' ? '~/app $ npm run build' : key === 'bob' ? 'docker ps -a' : 'openclaw: task done'
      setTimeout(() => {
        win.classList.remove('pipes-pulse')
        line.textContent = original
      }, 1400)
    }

    function schedulePulse() {
      pulseTimer = setTimeout(() => {
        if (running) pulseWorkspace()
        schedulePulse()
      }, 3200 + Math.random() * 1600)
    }

    function play() {
      if (running) return
      running = true
      section.classList.remove('pipes-paused')
      startRaf()
      if (!pulseTimer) schedulePulse()
    }

    function pause() {
      running = false
      section.classList.add('pipes-paused')
      stopRaf()
    }

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting ?? true
        if (visible && !document.hidden) play()
        else pause()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause()
      else if (io) play()
    })
  })()

  document.getElementById('pipes-install-copy')?.addEventListener('click', (e) => {
    const btn = e.currentTarget
    navigator.clipboard?.writeText('curl -fsSL https://mydevmachine.sh/install.sh | sh\ndevmachine setup')
    btn.textContent = 'Copied'
    setTimeout(() => {
      btn.textContent = 'Copy'
    }, 1500)
  })
</script>

<style>
  .pipes-hero {
    position: relative;
    min-height: 100svh;
    background: var(--hero-bg);
    display: flex;
    align-items: center;
    padding: 7rem 0 4rem;
    overflow-x: hidden;
    max-width: 100vw;
  }

  .pipes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    width: 100%;
    max-width: 100%;
    align-items: center;
  }

  @media (min-width: 900px) {
    .pipes-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 2rem;
    }
  }

  .pipes-copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .pipes-scene-wrap {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .pipes-svg {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    overflow: hidden;
  }

  .pipe-line {
    stroke: var(--line);
  }

  .pipe-flow-path {
    stroke: var(--muted);
    stroke-dasharray: 4 6;
    animation: pipes-dash-flow 2.4s linear infinite;
  }

  @keyframes pipes-dash-flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  .pipe-packet {
    fill: var(--ink);
  }

  .win-frame {
    fill: var(--card);
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .win-titlebar rect {
    fill: var(--card);
    stroke: var(--line);
    stroke-width: 1;
  }

  .win-dot {
    fill: var(--muted);
    opacity: 0.6;
  }

  .win-dot-sm {
    opacity: 0.5;
  }

  .win-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 9px;
    fill: var(--muted);
    letter-spacing: 0.02em;
  }

  .win-label-sm {
    font-size: 7.5px;
  }

  .win-dashed-grid line {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0.6;
  }

  .win-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10px;
    fill: var(--ink);
  }

  .win-mono-sm {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 8.5px;
    fill: var(--ink);
  }

  .win-prompt {
    fill: var(--muted);
  }

  .win-cursor {
    animation: pipes-blink 1s steps(1) infinite;
  }

  @keyframes pipes-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .pipes-window-inner .win-frame {
    transition: stroke 0.3s ease;
  }

  .pipes-pulse .win-frame {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .phone-card {
    fill: var(--bg);
    stroke: var(--line);
    stroke-width: 1;
  }

  .phone-card-text {
    fill: var(--ink);
  }

  .phone-status {
    fill: var(--muted);
  }

  .pipes-paused .pipe-flow-path {
    animation-play-state: paused;
  }

  .pipes-static .pipe-flow-path,
  .pipes-static .win-cursor {
    animation: none;
  }

  .pipes-static .pipe-packet {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pipe-flow-path,
    .win-cursor {
      animation: none;
    }
    .pipe-packet {
      display: none;
    }
  }
</style>
