---
interface Props {
  eyebrow: string
  headline: string
  subline: string
}

const { eyebrow, headline, subline } = Astro.props

const steps: { cmd: string; out: string[] }[] = [
  { cmd: 'brew install adevmachine/tap/devmachine', out: [] },
  {
    cmd: 'devmachine setup',
    out: [
      'wrote ~/.devmachine/config.yml',
      'password login is off; the key is the only way in.',
      'installing Ansible with Homebrew...',
      'Next: `devmachine doctor`, then `devmachine sync`.',
    ],
  },
  {
    cmd: 'devmachine workspaces new alice',
    out: [
      'alice is in the configuration, on main, with the default packages.',
      'The machine is untouched: `devmachine sync` is what creates the account.',
    ],
  },
  {
    cmd: 'devmachine sync',
    out: ['main: ok=12 changed=3 failed=0'],
  },
  {
    cmd: 'devmachine ssh alice',
    out: ['alice@main:~$'],
  },
  {
    cmd: 'claude',
    out: ['Ready. Ask it anything.'],
  },
]
---

<section class="hero" id="hero">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="hero-copy max-w-3xl mx-auto px-4 sm:px-6">
    <p class="hero-eyebrow text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-4">
      <span class="hero-eyebrow-dot"></span>
      {eyebrow}
    </p>
    <h1 class="text-5xl sm:text-7xl font-light leading-[0.95] tracking-tight" style="letter-spacing: -0.03em;">
      {headline}
    </h1>
    <p class="hero-subline text-base sm:text-lg text-[var(--muted)] mt-5 max-w-xl mx-auto">
      {subline}
    </p>
  </div>

  <div class="hero-terminal-wrap px-4 sm:px-6">
    <div class="terminal" id="hero-terminal">
      <div class="terminal-titlebar">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-title font-mono">~ devmachine</span>
      </div>
      <div class="terminal-body font-mono" id="hero-terminal-body">
        {
          steps.map((step) => (
            <>
              <div class="term-line">
                <span class="term-prompt">$</span>
                <span class="term-cmd">{step.cmd}</span>
              </div>
              {step.out.map((line) => (
                <div class="term-line term-out">{line}</div>
              ))}
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ steps }}>
  ;(() => {
    const section = document.getElementById('hero')
    const body = document.getElementById('hero-terminal-body')
    if (!(section instanceof HTMLElement) || !(body instanceof HTMLElement)) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduceMotion) return

    let visible = true
    let paused = false
    let generation = 0

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms))
    }

    async function waitWhilePaused(gen) {
      while ((paused || document.hidden) && gen === generation) {
        await sleep(150)
      }
    }

    function makeCursor() {
      const cursor = document.createElement('span')
      cursor.className = 'term-cursor'
      return cursor
    }

    function scrollToEnd() {
      body.scrollLeft = 0
      body.scrollTop = body.scrollHeight
    }

    async function typeCommand(gen, text) {
      const line = document.createElement('div')
      line.className = 'term-line'
      const prompt = document.createElement('span')
      prompt.className = 'term-prompt'
      prompt.textContent = '$'
      const cmd = document.createElement('span')
      cmd.className = 'term-cmd'
      line.appendChild(prompt)
      line.appendChild(cmd)
      const cursor = makeCursor()
      line.appendChild(cursor)
      body.appendChild(line)
      scrollToEnd()

      for (const ch of text) {
        if (gen !== generation) return
        await waitWhilePaused(gen)
        if (gen !== generation) return
        cmd.textContent += ch
        scrollToEnd()
        await sleep(30 + Math.random() * 15)
      }
      cursor.remove()
    }

    async function showOutputLine(gen, text) {
      if (gen !== generation) return
      await waitWhilePaused(gen)
      if (gen !== generation) return
      const line = document.createElement('div')
      line.className = 'term-line term-out'
      line.textContent = text
      body.appendChild(line)
      scrollToEnd()
      await sleep(180)
    }

    async function runLoop(gen) {
      while (gen === generation) {
        body.innerHTML = ''
        for (const step of steps) {
          if (gen !== generation) return
          await waitWhilePaused(gen)
          if (gen !== generation) return
          await typeCommand(gen, step.cmd)
          await sleep(220)
          for (const line of step.out) {
            await showOutputLine(gen, line)
          }
          await sleep(420)
        }
        const cursor = makeCursor()
        body.appendChild(cursor)
        await sleep(2600)
      }
    }

    function start() {
      if (!visible || document.hidden) return
      paused = false
    }

    function stop() {
      paused = true
    }

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true
        if (visible) start()
        else stop()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop()
      else start()
    })

    generation = 1
    runLoop(1)
  })()
</script>
