---
interface Props {
  eyebrow: string
  headline: string
  subline: string
}

const { eyebrow, headline, subline } = Astro.props

interface Step {
  cmd: string
  out: string[]
}

interface Win {
  id: string
  title: string
  typeMs: number
  steps: Step[]
}

interface MacLine {
  text: string
  tone: 'cmd' | 'ok' | 'muted' | 'agent'
  typed?: boolean
}

const macPanes: { name: string; lines: MacLine[] }[] = [
  {
    name: 'claude',
    lines: [
      { text: 'claude › fix retry loop', tone: 'agent', typed: true },
      { text: '● Edit(api/retry.ts)', tone: 'muted' },
      { text: '✓ 41 tests passed', tone: 'ok' },
    ],
  },
  {
    name: 'dev',
    lines: [
      { text: '$ npm run dev', tone: 'cmd', typed: true },
      { text: 'vite ready in 318 ms', tone: 'ok' },
      { text: '➜ localhost:5173', tone: 'muted' },
    ],
  },
  {
    name: 'codex',
    lines: [
      { text: 'codex › hero copy', tone: 'agent', typed: true },
      { text: '● Write(index.html)', tone: 'muted' },
    ],
  },
  {
    name: 'tests',
    lines: [
      { text: '$ npm test --watch', tone: 'cmd', typed: true },
      { text: 'PASS chart.test.ts', tone: 'ok' },
      { text: 'Tests: 18 passed', tone: 'muted' },
    ],
  },
]

const windows: Win[] = [
  {
    id: 'bob',
    title: 'bob@main',
    typeMs: 34,
    steps: [{ cmd: 'docker compose up', out: ['Container web  Started', 'Container db   Started'] }],
  },
  {
    id: 'acme',
    title: 'acme@main',
    typeMs: 40,
    steps: [{ cmd: 'npm run dev', out: ['Local: http://localhost:5173', 'ready in 312 ms'] }],
  },
  {
    id: 'you',
    title: 'you@laptop',
    typeMs: 28,
    steps: [
      { cmd: 'devmachine ssh acme', out: ['acme@main:~$'] },
      { cmd: 'devmachine sync', out: ['main: ok=12 changed=3 failed=0'] },
    ],
  },
]
---

<section class="hero" id="hero">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <canvas class="hero-grid-bg" id="hero-grid-bg" aria-hidden="true"></canvas>
  <div class="hero-copy max-w-3xl mx-auto px-4 sm:px-6">
    <p class="hero-eyebrow text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-4">
      <span class="hero-eyebrow-dot" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="text-5xl sm:text-7xl font-light leading-[0.95] tracking-tight" style="letter-spacing: -0.03em;">
      {headline}
    </h1>
    <p class="hero-subline text-base sm:text-lg text-[var(--muted)] mt-5 max-w-xl mx-auto">
      {subline}
    </p>
  </div>

  <p class="sr-only">
    Illustration: terminals for you, two workspaces and a coding agent, and the Mac app, all linked to one server.
  </p>
  <div class="hero-terminal-wrap px-4 sm:px-6" id="hero-terminal">
    <div class="hero-stage">
      <svg
        class="hero-link-svg"
        id="hero-link-svg"
        viewBox="0 0 1280 740"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <g class="hero-link-lines" fill="none" stroke-width="1.5">
          <path id="hero-link-you" class="hero-link-line" d="M 640 370 L 588.8 430"></path>
          <path id="hero-link-acme" class="hero-link-line" d="M 640 370 L 588.8 310"></path>
          <path id="hero-link-bob" class="hero-link-line" d="M 640 370 L 691.2 310"></path>
          <path id="hero-link-agent" class="hero-link-line" d="M 640 370 L 691.2 430"></path>
          <path id="hero-link-mac" class="hero-link-line" d="M 640 370 L 640 200"></path>
        </g>
        <circle id="hero-packet-you" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-acme" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-bob" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-agent" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-mac" class="hero-packet" r="3"></circle>
      </svg>
      <div class="hero-hub" aria-hidden="true">
        <svg width="82" height="82" viewBox="3.2 3.2 25.6 25.6">
          <defs>
            <linearGradient id="hero-hub-icon-gradient" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#0f172a" />
              <stop offset="1" stop-color="#1e1b4b" />
            </linearGradient>
          </defs>
          <rect x="3.2" y="3.2" width="25.6" height="25.6" rx="5.6" fill="url(#hero-hub-icon-gradient)" />
          <path
            d="M 11.6 9.8 L 18.4 16 L 11.6 22.2"
            fill="none"
            stroke="#28c840"
            stroke-width="2.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <rect x="20.2" y="18.9" width="5.4" height="2" rx="0.4" fill="#5aa9e6" />
        </svg>
      </div>
      {
        windows.map((win) => (
          <div class={`term-window term-${win.id}`} data-window={win.id}>
            <div class="terminal" aria-hidden="true">
              <div class="terminal-titlebar">
                <span class="terminal-dot" />
                <span class="terminal-dot" />
                <span class="terminal-dot" />
                <span class="terminal-title font-mono">{win.title}</span>
              </div>
              <div class="terminal-body font-mono" id={`term-body-${win.id}`}>
                <div class="term-line">
                  <span class="term-prompt">$</span>
                  <span class="term-cmd">{win.steps[0].cmd}</span>
                </div>
                {win.steps[0].out.map((line) => (
                  <div class="term-line term-out">{line}</div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
      <div class="term-window term-agent" data-window="agent">
        <div class="terminal" aria-hidden="true">
          <div class="terminal-titlebar">
            <span class="terminal-dot" />
            <span class="terminal-dot" />
            <span class="terminal-dot" />
            <span class="terminal-title font-mono">agent@main</span>
          </div>
          <div class="terminal-body font-mono" id="term-body-agent">
            <div class="term-line term-agent-welcome">✻ agent@main · ~/app</div>
          </div>
        </div>
      </div>
      <div class="term-window term-mac" data-window="mac">
        <button
          type="button"
          id="hero-motion"
          class="hero-motion-toggle"
          aria-label="Pause animation"
          aria-pressed="false"
          title="Pause animation"
        >
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" /><rect x="14" y="5" width="4" height="14" /></svg>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </button>
        <div class="mac-window" aria-hidden="true">
          <aside class="mac-sidebar">
            <div class="mac-lights">
              <span class="mac-light mac-light-close" />
              <span class="mac-light mac-light-min" />
              <span class="mac-light mac-light-max" />
            </div>
            <p class="mac-section">Workspaces</p>
            <p class="mac-ws"><span class="mac-chevron">›</span><span class="mac-ws-dot" />acme</p>
            <p class="mac-row mac-row-active"><span class="mac-glyph">&gt;_</span><span class="mac-row-text">claude — payments refactor</span></p>
            <p class="mac-row"><span class="mac-glyph">&gt;_</span><span class="mac-row-text">codex — landing page</span></p>
            <p class="mac-ws"><span class="mac-chevron">›</span><span class="mac-ws-dot" />globex</p>
            <p class="mac-row"><span class="mac-glyph">&gt;_</span><span class="mac-row-text">dashboard — tests</span></p>
            <p class="mac-section">Local</p>
            <p class="mac-row mac-row-operator"><span class="mac-glyph mac-glyph-operator">◆</span><span class="mac-row-text">Operator</span></p>
          </aside>
          <div class="mac-main">
            <header class="mac-toolbar">
              <span class="mac-title">Devmachine</span>
              <span class="mac-crumb">acme · payments refactor</span>
            </header>
            <div class="mac-panes font-mono">
              {
                macPanes.map((pane, p) => (
                  <div class={`mac-pane${p === 0 ? ' mac-pane-focus' : ''}`}>
                    <div class="mac-pane-head">{pane.name}</div>
                    <div class="mac-pane-body">
                      {pane.lines.map((line, i) => (
                        <div
                          class={`mac-line mac-line-${line.tone}${line.typed ? ' mac-line-typed' : ''}`}
                          style={`--delay: ${(p * 0.45 + i * 0.7).toFixed(2)}s`}
                        >
                          {line.text}
                        </div>
                      ))}
                      <span class="mac-cursor" style={`--delay: ${(p * 0.45 + pane.lines.length * 0.7).toFixed(2)}s`} />
                    </div>
                  </div>
                ))
              }
            </div>
            <footer class="mac-status">
              <span>Todos</span>
              <span class="mac-progress"><i /></span>
              <span>3/5</span>
              <span class="mac-status-host">acme · main</span>
            </footer>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ windows }}>
  ;(() => {
    const section = document.getElementById('hero')
    if (!(section instanceof HTMLElement)) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduceMotion) return

    let visible = true
    let paused = false
    let generation = 0

    const MAX_LINES = 5

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms))
    }

    async function waitWhilePaused(gen) {
      while ((paused || document.hidden || section.hasAttribute('data-paused')) && gen === generation) {
        await sleep(150)
      }
    }

    function makeCursor() {
      const cursor = document.createElement('span')
      cursor.className = 'term-cursor'
      return cursor
    }

    function trimLines(body) {
      while (body.children.length > MAX_LINES) {
        body.removeChild(body.firstElementChild)
      }
    }

    async function typeCommand(gen, body, text, typeMs) {
      const line = document.createElement('div')
      line.className = 'term-line'
      const prompt = document.createElement('span')
      prompt.className = 'term-prompt'
      prompt.textContent = '$'
      const cmd = document.createElement('span')
      cmd.className = 'term-cmd'
      line.appendChild(prompt)
      line.appendChild(cmd)
      const cursor = makeCursor()
      line.appendChild(cursor)
      body.appendChild(line)
      trimLines(body)

      for (const ch of text) {
        if (gen !== generation) return
        await waitWhilePaused(gen)
        if (gen !== generation) return
        cmd.textContent += ch
        await sleep(typeMs * 0.6 + Math.random() * typeMs * 0.5)
      }
      cursor.remove()
    }

    async function showOutputLine(gen, body, text) {
      if (gen !== generation) return
      await waitWhilePaused(gen)
      if (gen !== generation) return
      const line = document.createElement('div')
      line.className = 'term-line term-out'
      line.textContent = text
      body.appendChild(line)
      trimLines(body)
      await sleep(200)
    }

    async function runWindowLoop(gen, win) {
      const body = document.getElementById(`term-body-${win.id}`)
      if (!(body instanceof HTMLElement)) return
      while (gen === generation) {
        body.innerHTML = ''
        for (const step of win.steps) {
          if (gen !== generation) return
          await waitWhilePaused(gen)
          if (gen !== generation) return
          await typeCommand(gen, body, step.cmd, win.typeMs)
          await sleep(240)
          for (const line of step.out) {
            await showOutputLine(gen, body, line)
          }
          await sleep(500 + Math.random() * 400)
        }
        const cursor = makeCursor()
        body.appendChild(cursor)
        trimLines(body)
        await sleep(2400 + Math.random() * 800)
      }
    }

    function start() {
      if (!visible || document.hidden) return
      paused = false
    }

    function stop() {
      paused = true
    }

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true
        if (visible) start()
        else stop()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop()
      else start()
    })

    generation = 1
    for (const win of windows) {
      runWindowLoop(1, win)
    }
  })()
</script>

<script is:inline>
  ;(() => {
    const hero = document.getElementById('hero')
    const toggle = document.getElementById('hero-motion')
    if (!hero || !toggle) return
    toggle.addEventListener('click', () => {
      const paused = !hero.hasAttribute('data-paused')
      hero.toggleAttribute('data-paused', paused)
      toggle.setAttribute('aria-pressed', String(paused))
      toggle.title = paused ? 'Play animation' : 'Pause animation'
      hero.dispatchEvent(new Event('hero-motion'))
    })
  })()
</script>

<script is:inline>
  ;(() => {
    const section = document.getElementById('hero')
    const stage = document.querySelector('.hero-stage')
    const svg = document.getElementById('hero-link-svg')
    if (!(section instanceof HTMLElement) || !(stage instanceof HTMLElement) || !svg) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const desktopQuery = window.matchMedia('(min-width: 901px)')

    const VIEW_W = 1280
    const VIEW_H = 740
    const HUB = { x: VIEW_W / 2, y: VIEW_H / 2 }

    // An underdamped spring: the window overshoots a little and settles,
    // which is what makes the release read as elastic.
    const STIFFNESS = 220
    const DAMPING = 15

    const keys = ['you', 'acme', 'bob', 'agent', 'mac']
    const links = {}
    for (const key of keys) {
      const win = stage.querySelector(`[data-window="${key}"]`)
      const path = document.getElementById(`hero-link-${key}`)
      const packet = document.getElementById(`hero-packet-${key}`)
      if (!(win instanceof HTMLElement) || !(path instanceof SVGPathElement) || !packet) continue
      links[key] = { win, path, packet, x: 0, y: 0, vx: 0, vy: 0, dragging: false }
    }

    function place(link) {
      link.win.style.translate = link.x || link.y ? `${link.x}px ${link.y}px` : ''
    }

    // The line ends at the point of the window nearest the hub, so it stays
    // attached from any side while the window moves around it.
    function updateLines() {
      const box = stage.getBoundingClientRect()
      if (!box.width || !box.height) return
      const hubX = box.left + box.width / 2
      const hubY = box.top + box.height / 2
      for (const key of keys) {
        const link = links[key]
        if (!link) continue
        const r = link.win.getBoundingClientRect()
        const px = Math.min(Math.max(hubX, r.left), r.right)
        const py = Math.min(Math.max(hubY, r.top), r.bottom)
        const x = ((px - box.left) / box.width) * VIEW_W
        const y = ((py - box.top) / box.height) * VIEW_H
        link.path.setAttribute('d', `M ${HUB.x} ${HUB.y} L ${x.toFixed(1)} ${y.toFixed(1)}`)
      }
    }

    const cyclePeriod = 6000
    const travelDuration = 1100
    const phase = { you: 0, acme: 900, bob: 1800, agent: 2700, mac: 3600 }

    function movePackets(time) {
      for (const key of keys) {
        const link = links[key]
        if (!link) continue
        const local = (time + phase[key]) % cyclePeriod
        if (local >= travelDuration) {
          link.packet.setAttribute('opacity', '0')
          continue
        }
        const cycleIndex = Math.floor((time + phase[key]) / cyclePeriod)
        const outward = cycleIndex % 2 === 0
        const t = local / travelDuration
        const length = link.path.getTotalLength()
        const pos = link.path.getPointAtLength((outward ? t : 1 - t) * length)
        link.packet.setAttribute('cx', String(pos.x))
        link.packet.setAttribute('cy', String(pos.y))
        link.packet.setAttribute('opacity', String(Math.sin(Math.PI * t)))
      }
    }

    function stepSprings(dt) {
      let moving = false
      for (const key of keys) {
        const link = links[key]
        if (!link || link.dragging) continue
        if (!link.x && !link.y && !link.vx && !link.vy) continue
        link.vx += (-STIFFNESS * link.x - DAMPING * link.vx) * dt
        link.vy += (-STIFFNESS * link.y - DAMPING * link.vy) * dt
        link.x += link.vx * dt
        link.y += link.vy * dt
        if (Math.hypot(link.x, link.y) < 0.3 && Math.hypot(link.vx, link.vy) < 3) {
          link.x = link.y = link.vx = link.vy = 0
        } else {
          moving = true
        }
        place(link)
      }
      return moving
    }

    let visible = true
    let rafId = null
    let lastTime = 0

    function tick(time) {
      const dt = Math.min(lastTime ? (time - lastTime) / 1000 : 1 / 60, 1 / 30)
      lastTime = time
      const springing = stepSprings(dt)
      updateLines()
      if (!reduceMotion) movePackets(time)
      const dragging = keys.some((key) => links[key]?.dragging)
      const animating = !reduceMotion && visible && !document.hidden && !section.hasAttribute('data-paused')
      if (animating || springing || dragging) {
        rafId = requestAnimationFrame(tick)
      } else {
        rafId = null
      }
    }

    function wake() {
      if (rafId == null) {
        lastTime = 0
        rafId = requestAnimationFrame(tick)
      }
    }

    for (const key of keys) {
      const link = links[key]
      if (!link) continue
      let startX = 0
      let startY = 0

      link.win.addEventListener('pointerdown', (e) => {
        if (!desktopQuery.matches || e.button !== 0 || e.target.closest('button')) return
        link.dragging = true
        link.vx = link.vy = 0
        startX = e.clientX - link.x
        startY = e.clientY - link.y
        link.win.setPointerCapture(e.pointerId)
        link.win.classList.add('is-dragging')
        e.preventDefault()
        wake()
      })

      link.win.addEventListener('pointermove', (e) => {
        if (!link.dragging) return
        link.x = e.clientX - startX
        link.y = e.clientY - startY
        place(link)
      })

      const release = () => {
        if (!link.dragging) return
        link.dragging = false
        link.win.classList.remove('is-dragging')
        if (reduceMotion) {
          link.x = link.y = 0
          place(link)
        }
        wake()
      }
      link.win.addEventListener('pointerup', release)
      link.win.addEventListener('pointercancel', release)
      link.win.addEventListener('lostpointercapture', release)
    }

    section.addEventListener('hero-motion', wake)

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true
        if (visible) wake()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) wake()
    })
    window.addEventListener('resize', () => {
      updateLines()
      wake()
    })

    updateLines()
    wake()
  })()
</script>

<script is:inline>
  ;(() => {
    const section = document.getElementById('hero')
    const body = document.getElementById('term-body-agent')
    if (!(section instanceof HTMLElement) || !(body instanceof HTMLElement)) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduceMotion) return

    let visible = true
    let paused = false
    let generation = 0

    const MAX_LINES = 9
    const SPINNER_FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms))
    }

    async function waitWhilePaused(gen) {
      while ((paused || document.hidden || section.hasAttribute('data-paused')) && gen === generation) {
        await sleep(150)
      }
    }

    function trimLines() {
      while (body.children.length > MAX_LINES) {
        body.removeChild(body.firstElementChild)
      }
    }

    function appendLine(text, className) {
      const line = document.createElement('div')
      line.className = `term-line ${className}`
      line.textContent = text
      body.appendChild(line)
      trimLines()
      return line
    }

    async function typePrompt(gen, text) {
      const line = document.createElement('div')
      line.className = 'term-line term-agent-prompt'
      const marker = document.createElement('span')
      marker.className = 'term-agent-marker'
      marker.textContent = '>'
      const cmd = document.createElement('span')
      cmd.className = 'term-agent-prompt-text'
      line.appendChild(marker)
      line.appendChild(document.createTextNode(' '))
      line.appendChild(cmd)
      const cursor = document.createElement('span')
      cursor.className = 'term-cursor'
      line.appendChild(cursor)
      body.appendChild(line)
      trimLines()

      for (const ch of text) {
        if (gen !== generation) return
        await waitWhilePaused(gen)
        if (gen !== generation) return
        cmd.textContent += ch
        await sleep(20 + Math.random() * 20)
      }
      cursor.remove()
    }

    async function showThinking(gen, duration) {
      if (gen !== generation) return
      await waitWhilePaused(gen)
      if (gen !== generation) return
      const line = appendLine(`${SPINNER_FRAMES[0]} Thinking…`, 'term-agent-thinking')
      const start = Date.now()
      let i = 0
      while (Date.now() - start < duration) {
        if (gen !== generation) return
        await sleep(90)
        i = (i + 1) % SPINNER_FRAMES.length
        line.textContent = `${SPINNER_FRAMES[i]} Thinking…`
      }
      line.remove()
    }

    async function runAgentLoop(gen) {
      while (gen === generation) {
        body.innerHTML = ''
        appendLine('✻ agent@main · ~/app', 'term-agent-welcome')
        await sleep(400)
        if (gen !== generation) return
        await waitWhilePaused(gen)
        await typePrompt(gen, 'add a health check endpoint')
        await sleep(300)

        await showThinking(gen, 700)
        appendLine('● Read(src/server.ts)', 'term-agent-tool')
        await sleep(500)

        await showThinking(gen, 700)
        appendLine('● Edit(src/server.ts)', 'term-agent-tool')
        await sleep(250)
        appendLine("+  app.get('/health', (_req, res) => res.send('ok'))", 'term-agent-diff-add')
        await sleep(200)
        appendLine('-  // TODO: add a health check', 'term-agent-diff-del')
        await sleep(500)

        await showThinking(gen, 700)
        appendLine('● Bash(npm test)', 'term-agent-tool')
        await sleep(500)
        appendLine('✓ 12 passed', 'term-agent-result')
        await sleep(400)

        appendLine('Added GET /health and a test.', 'term-agent-reply')
        const cursor = document.createElement('span')
        cursor.className = 'term-cursor'
        body.appendChild(cursor)
        trimLines()
        await sleep(2600 + Math.random() * 800)
      }
    }

    function start() {
      if (!visible || document.hidden) return
      paused = false
    }

    function stop() {
      paused = true
    }

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true
        if (visible) start()
        else stop()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop()
      else start()
    })

    generation = 1
    runAgentLoop(1)
  })()
</script>

<script is:inline>
  ;(() => {
    const hero = document.getElementById('hero')
    const stage = document.querySelector('.hero-stage')
    const canvas = document.getElementById('hero-grid-bg')
    if (!(hero instanceof HTMLElement) || !(stage instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) return

    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const CELL = 40
    const PULSE_EVERY = 4500
    const PULSE_LIFE = 9500
    const BAND = 120

    let w = 0
    let h = 0
    let cx = 0
    let cy = 0
    let dpr = 1
    let colors = null
    let base = null
    let dots = []
    let visible = true
    let frame = 0

    function readColors() {
      const style = getComputedStyle(document.documentElement)
      const read = (name, fallback) => style.getPropertyValue(name).trim() || fallback
      return {
        line: read('--hero-line-rgb', '15, 20, 26'),
        lineAlpha: parseFloat(read('--hero-line-alpha', '0.1')),
        accent: read('--hero-accent-rgb', '37, 99, 235'),
        accentAlpha: parseFloat(read('--hero-accent-alpha', '0.5')),
      }
    }

    function fade(x, y) {
      const dx = (x - cx) / (w * 0.6)
      const dy = (y - cy) / (h * 0.6)
      return Math.max(0, 1 - Math.hypot(dx, dy))
    }

    function buildBase() {
      base = document.createElement('canvas')
      base.width = canvas.width
      base.height = canvas.height
      const b = base.getContext('2d')
      b.setTransform(dpr, 0, 0, dpr, 0, 0)
      const { line, lineAlpha, accent } = colors

      const glow = b.createRadialGradient(cx, cy, 0, cx, cy, Math.min(w, h) * 0.45)
      glow.addColorStop(0, `rgba(${accent}, ${lineAlpha * 1.6})`)
      glow.addColorStop(1, `rgba(${accent}, 0)`)
      b.fillStyle = glow
      b.fillRect(0, 0, w, h)

      const ox = cx % CELL
      const oy = cy % CELL
      b.lineWidth = 1
      for (let x = ox; x <= w; x += CELL) {
        const g = b.createLinearGradient(x, 0, x, h)
        g.addColorStop(0, `rgba(${line}, 0)`)
        g.addColorStop(0.5, `rgba(${line}, ${lineAlpha * fade(x, cy)})`)
        g.addColorStop(1, `rgba(${line}, 0)`)
        b.strokeStyle = g
        b.beginPath()
        b.moveTo(Math.round(x) + 0.5, 0)
        b.lineTo(Math.round(x) + 0.5, h)
        b.stroke()
      }
      for (let y = oy; y <= h; y += CELL) {
        const g = b.createLinearGradient(0, y, w, y)
        g.addColorStop(0, `rgba(${line}, 0)`)
        g.addColorStop(0.5, `rgba(${line}, ${lineAlpha * fade(cx, y)})`)
        g.addColorStop(1, `rgba(${line}, 0)`)
        b.strokeStyle = g
        b.beginPath()
        b.moveTo(0, Math.round(y) + 0.5)
        b.lineTo(w, Math.round(y) + 0.5)
        b.stroke()
      }

      dots = []
      for (let x = ox; x <= w; x += CELL) {
        for (let y = oy; y <= h; y += CELL) {
          const f = fade(x, y)
          if (f <= 0) continue
          dots.push({ x, y, f, d: Math.hypot(x - cx, y - cy) })
          b.fillStyle = `rgba(${line}, ${Math.min(1, lineAlpha * 2.6 * f)})`
          b.fillRect(x - 1, y - 1, 2, 2)
        }
      }

      const maxR = Math.hypot(w, h) / 2
      for (let r = 1; r <= 5; r++) {
        const radius = maxR * 0.17 * r
        b.strokeStyle = `rgba(${line}, ${lineAlpha * 2 * (1 - r / 6)})`
        b.setLineDash(r % 2 ? [] : [4, 6])
        b.beginPath()
        b.arc(cx, cy, radius, 0, Math.PI * 2)
        b.stroke()
      }
      b.setLineDash([])
    }

    function resize() {
      const rect = hero.getBoundingClientRect()
      const hub = stage.getBoundingClientRect()
      w = rect.width
      h = rect.height
      if (!w || !h) return false
      cx = hub.left - rect.left + hub.width / 2
      cy = hub.top - rect.top + hub.height / 2
      dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.max(1, Math.round(w * dpr))
      canvas.height = Math.max(1, Math.round(h * dpr))
      colors = readColors()
      buildBase()
      return true
    }

    // The windows are translucent on purpose, for depth; the grid showing
    // through them would muddy their text, so their footprint stays clear.
    function clearUnderWindows() {
      const origin = hero.getBoundingClientRect()
      for (const win of stage.querySelectorAll('.term-window')) {
        const box = win.getBoundingClientRect()
        ctx.clearRect(box.left - origin.left, box.top - origin.top, box.width, box.height)
      }
    }

    function draw(now) {
      const size = hero.getBoundingClientRect()
      if (size.width !== w || size.height !== h) resize()
      if (!base) return
      ctx.setTransform(1, 0, 0, 1, 0, 0)
      ctx.clearRect(0, 0, canvas.width, canvas.height)
      ctx.drawImage(base, 0, 0)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      if (reduceMotion) {
        clearUnderWindows()
        return
      }

      const maxR = Math.hypot(w, h) / 2
      const { accent, accentAlpha } = colors
      const first = Math.floor((now - PULSE_LIFE) / PULSE_EVERY) + 1
      for (let k = first; k * PULSE_EVERY <= now; k++) {
        const t = (now - k * PULSE_EVERY) / PULSE_LIFE
        if (t < 0 || t > 1) continue
        const radius = 50 + (maxR - 50) * (1 - Math.pow(1 - t, 2))
        const life = 1 - t

        ctx.strokeStyle = `rgba(${accent}, ${accentAlpha * life})`
        ctx.lineWidth = 1
        ctx.beginPath()
        ctx.arc(cx, cy, radius, 0, Math.PI * 2)
        ctx.stroke()

        for (const dot of dots) {
          const near = 1 - Math.abs(dot.d - radius) / BAND
          if (near <= 0) continue
          const a = accentAlpha * 1.2 * near * near * life * dot.f
          ctx.fillStyle = `rgba(${accent}, ${Math.min(1, a)})`
          const size = 2 + 2 * near
          ctx.fillRect(dot.x - size / 2, dot.y - size / 2, size, size)
        }
      }
      clearUnderWindows()
    }

    function loop(now) {
      frame = 0
      if (!visible || document.hidden || hero.hasAttribute('data-paused')) return
      draw(now)
      frame = requestAnimationFrame(loop)
    }

    function start() {
      draw(performance.now())
      if (reduceMotion || hero.hasAttribute('data-paused')) return
      if (!frame) frame = requestAnimationFrame(loop)
    }

    if (resize()) start()

    // Not window resize: a scrollbar appearing after load narrows the hero
    // without one, and a canvas left at the old width stretches out of line
    // with the windows it clears.
    new ResizeObserver(() => {
      if (resize()) start()
    }).observe(hero)
    new MutationObserver(() => {
      if (resize()) start()
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    document.addEventListener('visibilitychange', start)
    hero.addEventListener('hero-motion', start)
    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting)
      start()
    }).observe(hero)
  })()
</script>

