---
interface Props {
  eyebrow: string
  headline: string
  subline: string
}

const { eyebrow, headline, subline } = Astro.props

interface Step {
  cmd: string
  out: string[]
}

interface Win {
  id: string
  title: string
  typeMs: number
  steps: Step[]
}

const windows: Win[] = [
  {
    id: 'agent',
    title: 'agent@main',
    typeMs: 46,
    steps: [
      { cmd: 'claude -p "fix the failing test"', out: ['Fixed: tests/login.test.ts passes.'] },
      { cmd: 'claude', out: ['Ready. Ask it anything.'] },
    ],
  },
  {
    id: 'bob',
    title: 'bob@main',
    typeMs: 34,
    steps: [{ cmd: 'docker compose up', out: ['Container web  Started', 'Container db   Started'] }],
  },
  {
    id: 'alice',
    title: 'alice@main',
    typeMs: 40,
    steps: [{ cmd: 'npm run dev', out: ['Local: http://localhost:5173', 'ready in 312 ms'] }],
  },
  {
    id: 'you',
    title: 'you@laptop',
    typeMs: 28,
    steps: [
      { cmd: 'devmachine ssh alice', out: ['alice@main:~$'] },
      { cmd: 'devmachine sync', out: ['main: ok=12 changed=3 failed=0'] },
    ],
  },
]
---

<section class="hero" id="hero">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="hero-copy max-w-3xl mx-auto px-4 sm:px-6">
    <p class="hero-eyebrow text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-4">
      <span class="hero-eyebrow-dot"></span>
      {eyebrow}
    </p>
    <h1 class="text-5xl sm:text-7xl font-light leading-[0.95] tracking-tight" style="letter-spacing: -0.03em;">
      {headline}
    </h1>
    <p class="hero-subline text-base sm:text-lg text-[var(--muted)] mt-5 max-w-xl mx-auto">
      {subline}
    </p>
  </div>

  <div class="hero-terminal-wrap px-4 sm:px-6" id="hero-terminal">
    <div class="hero-stage">
      <svg
        class="hero-link-svg"
        id="hero-link-svg"
        viewBox="0 0 992 448"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <g class="hero-link-lines" fill="none" stroke-width="1.5">
          <path id="hero-link-you" class="hero-link-line" d="M 496 233 L 496 144"></path>
          <path id="hero-link-alice" class="hero-link-line" d="M 496 233 Q 496 96 121 96"></path>
          <path id="hero-link-bob" class="hero-link-line" d="M 496 233 Q 496 24 636 24"></path>
          <path id="hero-link-agent" class="hero-link-line" d="M 496 233 Q 496 8 55 8"></path>
        </g>
        <circle id="hero-packet-you" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-alice" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-bob" class="hero-packet" r="3"></circle>
        <circle id="hero-packet-agent" class="hero-packet" r="3"></circle>
        <g class="hero-hub" transform="translate(479, 216)">
          <rect width="34" height="34" class="hero-hub-box"></rect>
          <text x="17" y="47" text-anchor="middle" class="hero-hub-label font-mono">devmachine</text>
        </g>
      </svg>
      {
        windows.map((win) => (
          <div class={`term-window term-${win.id}`} data-window={win.id}>
            <div class="terminal">
              <div class="terminal-titlebar">
                <span class="terminal-dot" />
                <span class="terminal-dot" />
                <span class="terminal-dot" />
                <span class="terminal-title font-mono">{win.title}</span>
              </div>
              <div class="terminal-body font-mono" id={`term-body-${win.id}`}>
                <div class="term-line">
                  <span class="term-prompt">$</span>
                  <span class="term-cmd">{win.steps[0].cmd}</span>
                </div>
                {win.steps[0].out.map((line) => (
                  <div class="term-line term-out">{line}</div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline define:vars={{ windows }}>
  ;(() => {
    const section = document.getElementById('hero')
    if (!(section instanceof HTMLElement)) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduceMotion) return

    let visible = true
    let paused = false
    let generation = 0

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms))
    }

    async function waitWhilePaused(gen) {
      while ((paused || document.hidden) && gen === generation) {
        await sleep(150)
      }
    }

    function makeCursor() {
      const cursor = document.createElement('span')
      cursor.className = 'term-cursor'
      return cursor
    }

    async function typeCommand(gen, body, text, typeMs) {
      const line = document.createElement('div')
      line.className = 'term-line'
      const prompt = document.createElement('span')
      prompt.className = 'term-prompt'
      prompt.textContent = '$'
      const cmd = document.createElement('span')
      cmd.className = 'term-cmd'
      line.appendChild(prompt)
      line.appendChild(cmd)
      const cursor = makeCursor()
      line.appendChild(cursor)
      body.appendChild(line)
      body.scrollTop = body.scrollHeight

      for (const ch of text) {
        if (gen !== generation) return
        await waitWhilePaused(gen)
        if (gen !== generation) return
        cmd.textContent += ch
        body.scrollTop = body.scrollHeight
        await sleep(typeMs * 0.6 + Math.random() * typeMs * 0.5)
      }
      cursor.remove()
    }

    async function showOutputLine(gen, body, text) {
      if (gen !== generation) return
      await waitWhilePaused(gen)
      if (gen !== generation) return
      const line = document.createElement('div')
      line.className = 'term-line term-out'
      line.textContent = text
      body.appendChild(line)
      body.scrollTop = body.scrollHeight
      await sleep(200)
    }

    async function runWindowLoop(gen, win) {
      const body = document.getElementById(`term-body-${win.id}`)
      if (!(body instanceof HTMLElement)) return
      while (gen === generation) {
        body.innerHTML = ''
        for (const step of win.steps) {
          if (gen !== generation) return
          await waitWhilePaused(gen)
          if (gen !== generation) return
          await typeCommand(gen, body, step.cmd, win.typeMs)
          await sleep(240)
          for (const line of step.out) {
            await showOutputLine(gen, body, line)
          }
          await sleep(500 + Math.random() * 400)
        }
        const cursor = makeCursor()
        body.appendChild(cursor)
        await sleep(2400 + Math.random() * 800)
      }
    }

    function start() {
      if (!visible || document.hidden) return
      paused = false
    }

    function stop() {
      paused = true
    }

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true
        if (visible) start()
        else stop()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop()
      else start()
    })

    generation = 1
    for (const win of windows) {
      runWindowLoop(1, win)
    }
  })()
</script>

<script is:inline>
  ;(() => {
    const section = document.getElementById('hero')
    const svg = document.getElementById('hero-link-svg')
    if (!(section instanceof HTMLElement) || !svg) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduceMotion) return

    const keys = ['you', 'alice', 'bob', 'agent']
    const paths = {}
    const lengths = {}
    const packets = {}
    for (const key of keys) {
      const path = document.getElementById(`hero-link-${key}`)
      const packet = document.getElementById(`hero-packet-${key}`)
      if (path instanceof SVGPathElement && packet) {
        paths[key] = path
        lengths[key] = path.getTotalLength()
        packets[key] = packet
      }
    }

    const cyclePeriod = 6000
    const travelDuration = 1100
    const phase = { you: 0, alice: 900, bob: 1800, agent: 2700 }

    let running = false
    let rafId = null

    function tick(time) {
      if (!running) return
      for (const key of keys) {
        const path = paths[key]
        const packet = packets[key]
        if (!path || !packet) continue
        const local = (time + phase[key]) % cyclePeriod
        if (local < travelDuration) {
          const cycleIndex = Math.floor((time + phase[key]) / cyclePeriod)
          const outward = cycleIndex % 2 === 0
          const t = local / travelDuration
          const pos = path.getPointAtLength((outward ? t : 1 - t) * lengths[key])
          packet.setAttribute('cx', String(pos.x))
          packet.setAttribute('cy', String(pos.y))
          packet.setAttribute('opacity', String(Math.sin(Math.PI * t)))
        } else {
          packet.setAttribute('opacity', '0')
        }
      }
      rafId = requestAnimationFrame(tick)
    }

    function play() {
      if (running) return
      running = true
      rafId = requestAnimationFrame(tick)
    }

    function pause() {
      running = false
      if (rafId != null) cancelAnimationFrame(rafId)
      rafId = null
    }

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting ?? true
        if (visible && !document.hidden) play()
        else pause()
      },
      { threshold: 0 },
    )
    io.observe(section)

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause()
      else play()
    })
  })()
</script>

<style>
  .hero-link-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: none;
  }

  @media (min-width: 901px) {
    .hero-link-svg {
      display: block;
    }
  }

  .hero-link-line {
    stroke: var(--muted);
    opacity: 0.35;
  }

  .hero-hub-box {
    fill: var(--hero-bg-center);
    stroke: var(--muted);
    stroke-width: 1.5;
  }

  .hero-hub-label {
    font-size: 9px;
    fill: var(--muted);
    letter-spacing: 0.02em;
  }

  .hero-packet {
    fill: #5aa9e6;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-packet {
      display: none;
    }
  }
</style>
