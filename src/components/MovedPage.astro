---
interface Props {
  to: string
  title: string
}

const { to, title } = Astro.props
const target = new URL(to, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — devmachine guides</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash)</script>
  </head>
  <body data-pagefind-ignore="all">
    <main>
      <p>This page moved to <a href={to}>{title}</a>.</p>
    </main>
  </body>
</html>
