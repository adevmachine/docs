---
interface NavGroup {
  section: string
  items: { title: string; url: string; id: string }[]
}

interface Props {
  groups: NavGroup[]
  currentUrl: string
}

const { groups, currentUrl } = Astro.props
---

<nav aria-label="Documentation" class="text-sm">
  {
    groups.map((group) => (
      <div class="mb-6">
        <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mb-2">{group.section}</p>
        <ul class="space-y-1">
          {group.items.map((item) => (
            <li>
              <a
                href={item.url}
                aria-current={item.url === currentUrl ? 'page' : undefined}
                class:list={[
                  'block py-1 px-2 -mx-2',
                  item.url === currentUrl ? 'font-semibold bg-[var(--card)] border hairline' : 'text-[var(--muted)] hover:text-[var(--ink)]',
                ]}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
