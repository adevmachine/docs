---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
const base = import.meta.env.BASE_URL

const howItWorks = [
  {
    title: 'Connect your server',
    body: 'Run devmachine setup and answer a few questions. It connects to your server and locks it down, so only you can get in.',
    href: `${base}how-it-works/trust-bootstrap/`,
  },
  {
    title: 'A workspace per project',
    body: 'Each project gets its own space on the server, with git, GitHub and Node ready. Open it by name.',
    href: `${base}concepts/machines-and-workspaces/`,
  },
  {
    title: 'Add tools with one command',
    body: 'Claude Code, Docker, your GitHub login. Add one, run devmachine sync, and it is installed.',
    href: `${base}concepts/packages/`,
  },
]

const principles = [
  {
    title: 'Fully open source',
    body: 'All of it is open source. Read it, fork it, change it.',
  },
  {
    title: 'No lock-in',
    body: 'Underneath it is plain Linux, SSH and git. Stop using devmachine and your server still works.',
  },
  {
    title: 'Extensible via packages',
    body: 'Add a tool with one package, or write your own.',
    href: `${base}concepts/packages/`,
  },
  {
    title: 'Your machines, your data',
    body: 'A VPS you rent, a computer you already have, or a virtual machine on your own. Up to you.',
  },
]

const machines = [
  {
    title: 'A VPS',
    body: 'Rent a server with Debian or Ubuntu that you can reach as root over SSH. It is always on, so you can code from anywhere.',
    href: `${base}getting-started/`,
    link: 'Connect your server',
  },
  {
    title: 'A computer you already have',
    body: 'An old laptop, a Linux box sitting idle, a Mac at the office running a Linux virtual machine. Join it to a private network with Tailscale or another VPN, and devmachine reaches it like any server.',
    href: `${base}concepts/reaching-your-server/`,
    link: 'Reach it over a private network',
  },
  {
    title: 'Your own computer, to try',
    body: 'No machine yet? devmachine can make a virtual machine on your computer and set it up exactly like a VPS. Throw it away when you are done.',
    href: `${base}examples/a-local-vm-with-lima/`,
    link: 'Try it on your own computer first',
  },
]

const tiers = [
  { label: 'A few apps', ram: '8 GB RAM', cpu: '2 vCPU', disk: '100 GB disk', body: 'One or two apps and a coding agent.' },
  { label: 'Recommended', ram: '16 GB RAM', cpu: '4 vCPU', disk: '200 GB disk', body: 'Several apps and coding agents at once.' },
  { label: 'Full development', ram: '32 GB RAM', cpu: '8 vCPU', disk: '400 GB disk', body: 'Docker and many intensive apps running together.' },
]
const recommendedTier = 1

const commands = [
  { cmd: 'devmachine setup', desc: 'connect your server and make it safe' },
  { cmd: 'devmachine workspaces new alice', desc: 'add your first workspace' },
  { cmd: 'devmachine sync', desc: 'build it on your server' },
  { cmd: 'devmachine ssh alice', desc: 'open it and start working' },
]
---


<BaseLayout title="devmachine - Code from anywhere." current="home">
  <Hero
    eyebrow="Your server, as workspaces"
    headline="Code from anywhere."
    subline="Your own server. One workspace per project. Ready in a few commands."
  />

  <section id="principles" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-16">
    <div class="grid-cards grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((item) => {
          const Tag = item.href ? 'a' : 'div'
          return (
            <Tag href={item.href} class:list={['block p-6', item.href && 'hover:bg-[var(--card)]']}>
              <h3 class="text-lg font-light tracking-tight mb-2">{item.title}</h3>
              <p class="text-sm text-[var(--muted)] leading-relaxed">{item.body}</p>
            </Tag>
          )
        })
      }
    </div>
  </section>

  <section id="before-you-start" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">01 / Before you start</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">First, a machine.</h2>
    <p class="text-[var(--muted)] max-w-2xl mb-10">
      devmachine needs one machine to set up. Pick whichever you have. Your computer reaches it
      through the devmachine CLI, over the internet or over a private network like Tailscale.
    </p>

    <div class="grid-cards grid-cols-1 sm:grid-cols-3">
      {
        machines.map((m, i) => (
          <div class="p-6 flex flex-col">
            <p class="text-xs font-mono text-[var(--muted)] mb-10">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="text-2xl font-light tracking-tight mb-3">{m.title}</h3>
            <p class="text-sm text-[var(--muted)] leading-relaxed mb-4">{m.body}</p>
            <p class="text-sm mt-auto">
              <a href={m.href} class="underline underline-offset-2 hover:text-[var(--ink)]">{m.link} →</a>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="get-started" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">02 / Get started</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-6">Two ways to start.</h2>

    <div>
      <div role="tablist" aria-label="Ways to get started" class="flex border hairline">
        <button
          role="tab"
          id="tab-yourself"
          aria-controls="panel-yourself"
          aria-selected="true"
          tabindex="0"
          class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
        >
          Yourself
        </button>
        <button
          role="tab"
          id="tab-agent"
          aria-controls="panel-agent"
          aria-selected="false"
          tabindex="-1"
          class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
        >
          With your agent
        </button>
      </div>

      <div role="tabpanel" id="panel-yourself" aria-labelledby="tab-yourself" tabindex="0" class="pt-6">
        <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">From your computer, run</p>
        <div class="border hairline bg-[var(--card)] p-4 sm:p-5 relative font-mono text-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <code id="install-cmd" class="min-w-0 break-all leading-relaxed">brew install mydevmachine/tap/devmachine<br />devmachine setup</code>
            <button
              id="install-copy"
              type="button"
              class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
            >
              Copy
            </button>
          </div>
        </div>
        <p class="text-sm mt-3 text-[var(--muted)]">
          Then <code class="font-mono text-[var(--ink)]">devmachine workspaces new alice && devmachine sync</code>,
          and <code class="font-mono text-[var(--ink)]">devmachine ssh alice</code>.
          <a href={`${base}getting-started/`} class="underline underline-offset-2 hover:text-[var(--ink)]">
            Getting started →
          </a>
        </p>
      </div>

      <div role="tabpanel" id="panel-agent" aria-labelledby="tab-agent" tabindex="0" class="pt-6" hidden>
        <p class="text-sm text-[var(--muted)] mb-3">
          Paste this into Claude Code, Codex or Cursor. It asks what it needs and does
          the rest; you only run <code class="font-mono text-[var(--ink)]">devmachine setup</code> yourself.
        </p>
        <div class="border hairline bg-[var(--card)] p-4 sm:p-5 font-mono text-sm">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <code id="agent-prompt" class="min-w-0 break-all">Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.</code>
            <button
              id="agent-prompt-copy"
              type="button"
              class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
            >
              Copy
            </button>
          </div>
        </div>
        <p class="text-sm mt-3">
          <a href={`${base}agent-setup/`} class="underline underline-offset-2 text-[var(--muted)] hover:text-[var(--ink)]">
            Read what it will do
          </a>
        </p>
        <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mt-3">
          For LLMs:
          <a href={`${base}llms.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms.txt</a>
          ·
          <a href={`${base}llms-full.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms-full.txt</a>
        </p>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="dark-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">03 / How it works</p>
      <div class="grid grid-cols-1 gap-6 min-[900px]:grid-cols-2 min-[900px]:gap-12 mb-12">
        <h2 class="text-3xl sm:text-4xl font-light tracking-tight">Three ideas, in order.</h2>
        <p class="text-[#9a9a9a] max-w-2xl">
          One command connects the server. One command makes a workspace.
          One command adds a tool to it.
        </p>
      </div>
      <div class="grid-cards grid-cols-1 sm:grid-cols-3">
        {
          howItWorks.map((item, i) => (
            <a href={item.href} class="block p-6 hover:bg-white/5">
              <p class="text-xs font-mono text-[#9a9a9a] mb-10">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="text-2xl font-light tracking-tight mb-3">{item.title}</h3>
              <p class="text-sm text-[#9a9a9a] leading-relaxed">{item.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="first-commands" class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-10">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">04 / First commands</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-10">Four commands.</h2>
    <div class="grid grid-cols-1 gap-4">
      {
        commands.map((c) => (
          <div class="border hairline p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-6">
            <div class="overflow-x-auto">
              <code class="font-mono text-sm whitespace-nowrap block">{c.cmd}</code>
            </div>
            <p class="text-sm text-[var(--muted)] sm:text-right shrink-0">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </section>


  <section id="measure-your-needs" class="max-w-6xl mx-auto px-4 sm:px-6 pt-28 pb-32">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">05 / Requirements</p>
    <div class="grid grid-cols-1 gap-6 min-[900px]:grid-cols-2 min-[900px]:gap-12 mb-10">
      <h2 class="text-3xl sm:text-4xl font-light tracking-tight">Measure your needs.</h2>
      <p class="text-[var(--muted)] max-w-2xl">
        Rent what you need, not more. Count how many apps and coding agents you will run at the
        same time, pick the size below, and move up later if it gets slow. A computer you
        already have works too, if it runs Debian or Ubuntu.
      </p>
    </div>
    <div id="sizing" class="border hairline p-6 mb-4">
      <label for="sizing-range" class="sr-only">How much will you run on the server?</label>
      <input
        id="sizing-range"
        type="range"
        min="0"
        max={tiers.length - 1}
        step="1"
        value={recommendedTier}
        aria-valuetext={tiers[recommendedTier].label}
        class="w-full accent-[#5aa9e6] cursor-pointer"
      />
      <div class="grid grid-cols-3 text-xs font-mono uppercase tracking-wide mt-2">
        {
          tiers.map((tier, i) => (
            <button
              type="button"
              data-tier={i}
              class:list={[
                'sizing-label py-1',
                i === 0 && 'text-left',
                i === 1 && 'text-center',
                i === 2 && 'text-right',
                i === recommendedTier ? 'text-[#5aa9e6]' : 'text-[var(--muted)]',
              ]}
            >
              {tier.label}
            </button>
          ))
        }
      </div>
      {
        tiers.map((tier, i) => (
          <div data-tier-panel={i} hidden={i !== recommendedTier} class="mt-6" aria-live="polite">
            <p class="text-2xl sm:text-3xl font-light tracking-tight mb-1">{tier.ram}</p>
            <p class="text-sm font-mono text-[var(--muted)] mb-3">{tier.cpu} · {tier.disk} · Debian or Ubuntu</p>
            <p class="text-sm text-[var(--muted)] leading-relaxed">{tier.body}</p>
          </div>
        ))
      }
    </div>
    <p class="text-xs text-[var(--muted)]">
      Any Debian or Ubuntu VPS works.
      No VPS yet?
      <a
        href="https://www.hostinger.com/br?REFERRALCODE=MYDEVMACHINE"
        target="_blank"
        rel="noopener sponsored"
        class="underline underline-offset-2 hover:text-[var(--ink)]"
      >
        See the Hostinger deals →
      </a>
    </p>
  </section>

  <script is:inline>
    ;(() => {
      const tabs = Array.from(document.querySelectorAll('#get-started [role="tab"]'))
      if (!tabs.length) return

      function selectTab(tab, focus) {
        for (const t of tabs) {
          const selected = t === tab
          t.setAttribute('aria-selected', String(selected))
          t.tabIndex = selected ? 0 : -1
          const panel = document.getElementById(t.getAttribute('aria-controls'))
          if (panel) panel.hidden = !selected
        }
        if (focus) tab.focus()
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => selectTab(tab, false))
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault()
            const dir = e.key === 'ArrowRight' ? 1 : -1
            const next = tabs[(i + dir + tabs.length) % tabs.length]
            selectTab(next, true)
          }
        })
      })
    })()

    ;(() => {
      const range = document.getElementById('sizing-range')
      if (!range) return
      const labels = Array.from(document.querySelectorAll('#sizing .sizing-label'))
      const panels = Array.from(document.querySelectorAll('#sizing [data-tier-panel]'))

      function show(index) {
        range.value = String(index)
        range.setAttribute('aria-valuetext', labels[index]?.textContent.trim() ?? '')
        labels.forEach((label, i) => {
          label.classList.toggle('text-[#5aa9e6]', i === index)
          label.classList.toggle('text-[var(--muted)]', i !== index)
        })
        panels.forEach((panel, i) => {
          panel.hidden = i !== index
        })
      }

      range.addEventListener('input', () => show(Number(range.value)))
      labels.forEach((label, i) => label.addEventListener('click', () => show(i)))
    })()

    document.getElementById('install-copy')?.addEventListener('click', (e) => {
      const btn = e.currentTarget
      navigator.clipboard?.writeText('brew install mydevmachine/tap/devmachine\ndevmachine setup')
      btn.textContent = 'Copied'
      setTimeout(() => {
        btn.textContent = 'Copy'
      }, 1500)
    })

    document.getElementById('agent-prompt-copy')?.addEventListener('click', (e) => {
      const btn = e.currentTarget
      navigator.clipboard?.writeText(
        'Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.',
      )
      btn.textContent = 'Copied'
      setTimeout(() => {
        btn.textContent = 'Copy'
      }, 1500)
    })
  </script>
</BaseLayout>
