---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
const base = import.meta.env.BASE_URL

const howItWorks = [
  {
    title: 'Connect your server',
    body: 'Run devmachine setup and answer a few questions. It connects to your server and locks it down, so only you can get in.',
    href: `${base}how-it-works/trust-bootstrap/`,
  },
  {
    title: 'A workspace per project',
    body: 'Each project gets its own space on the server, with git, GitHub and Node ready. Open it by name.',
    href: `${base}concepts/machines-and-workspaces/`,
  },
  {
    title: 'Add tools with one command',
    body: 'Claude Code, Docker, your GitHub login. Add one, run devmachine sync, and it is installed.',
    href: `${base}concepts/packages/`,
  },
]

const commands = [
  { cmd: 'devmachine setup', desc: 'connect your server and make it safe' },
  { cmd: 'devmachine workspaces new alice', desc: 'add your first workspace' },
  { cmd: 'devmachine sync', desc: 'build it on your server' },
  { cmd: 'devmachine ssh alice', desc: 'open it and start working' },
]
---

<BaseLayout title="devmachine — your VPS, as workspaces" current="home">
  <Hero
    eyebrow="Your server, as workspaces"
    headline="Code from anywhere."
    subline="Your own server. One workspace per project. Ready in a few commands."
  />

  <section id="get-started" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">01 / Get started</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-6">Two ways to start.</h2>

    <div class="max-w-xl">
      <div role="tablist" aria-label="Ways to get started" class="flex border hairline">
        <button
          role="tab"
          id="tab-yourself"
          aria-controls="panel-yourself"
          aria-selected="true"
          tabindex="0"
          class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
        >
          Yourself
        </button>
        <button
          role="tab"
          id="tab-agent"
          aria-controls="panel-agent"
          aria-selected="false"
          tabindex="-1"
          class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
        >
          With your agent
        </button>
      </div>

      <div role="tabpanel" id="panel-yourself" aria-labelledby="tab-yourself" tabindex="0" class="pt-5">
        <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">From your computer, run</p>
        <div class="border hairline bg-[var(--card)] p-4 sm:p-5 relative font-mono text-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <code id="install-cmd" class="min-w-0 break-all leading-relaxed">brew install mydevmachine/tap/devmachine<br />devmachine setup</code>
            <button
              id="install-copy"
              type="button"
              class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
            >
              Copy
            </button>
          </div>
        </div>
        <p class="text-sm mt-3 text-[var(--muted)]">
          Then <code class="font-mono text-[var(--ink)]">devmachine workspaces new alice && devmachine sync</code>,
          and <code class="font-mono text-[var(--ink)]">devmachine ssh alice</code>.
          <a href={`${base}getting-started/`} class="underline underline-offset-2 hover:text-[var(--ink)]">
            Getting started →
          </a>
        </p>
      </div>

      <div role="tabpanel" id="panel-agent" aria-labelledby="tab-agent" tabindex="0" class="pt-5" hidden>
        <p class="text-sm text-[var(--muted)] mb-3">
          Paste this into Claude Code, Codex or Cursor. It asks what it needs and does
          the rest; you only run <code class="font-mono text-[var(--ink)]">devmachine setup</code> yourself.
        </p>
        <div class="border hairline bg-[var(--card)] p-4 sm:p-5 font-mono text-sm">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <code id="agent-prompt" class="min-w-0 break-all">Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.</code>
            <button
              id="agent-prompt-copy"
              type="button"
              class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
            >
              Copy
            </button>
          </div>
        </div>
        <p class="text-sm mt-3">
          <a href={`${base}agent-setup/`} class="underline underline-offset-2 text-[var(--muted)] hover:text-[var(--ink)]">
            Read what it will do
          </a>
        </p>
        <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mt-3">
          For LLMs:
          <a href={`${base}llms.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms.txt</a>
          ·
          <a href={`${base}llms-full.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms-full.txt</a>
        </p>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="dark-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">02 / How it works</p>
      <div class="grid grid-cols-1 gap-6 min-[900px]:grid-cols-2 min-[900px]:gap-12 mb-12">
        <h2 class="text-3xl sm:text-4xl font-light tracking-tight">Three ideas, in order.</h2>
        <p class="text-[#9a9a9a] max-w-2xl">
          One command connects the server. One command makes a workspace.
          One command adds a tool to it.
        </p>
      </div>
      <div class="grid-cards grid-cols-1 sm:grid-cols-3">
        {
          howItWorks.map((item, i) => (
            <a href={item.href} class="block p-6 hover:bg-white/5">
              <p class="text-xs font-mono text-[#9a9a9a] mb-10">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="text-2xl font-light tracking-tight mb-3">{item.title}</h3>
              <p class="text-sm text-[#9a9a9a] leading-relaxed">{item.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="first-commands" class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-10">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">03 / First commands</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-10">Four commands.</h2>
    <div class="grid grid-cols-1 gap-4 max-w-3xl">
      {
        commands.map((c) => (
          <div class="border hairline p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
            <div class="overflow-x-auto sm:shrink-0 sm:w-[26rem]">
              <code class="font-mono text-sm whitespace-nowrap block">{c.cmd}</code>
            </div>
            <p class="text-sm text-[var(--muted)]">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <script is:inline>
    ;(() => {
      const tabs = Array.from(document.querySelectorAll('#get-started [role="tab"]'))
      if (!tabs.length) return

      function selectTab(tab, focus) {
        for (const t of tabs) {
          const selected = t === tab
          t.setAttribute('aria-selected', String(selected))
          t.tabIndex = selected ? 0 : -1
          const panel = document.getElementById(t.getAttribute('aria-controls'))
          if (panel) panel.hidden = !selected
        }
        if (focus) tab.focus()
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => selectTab(tab, false))
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault()
            const dir = e.key === 'ArrowRight' ? 1 : -1
            const next = tabs[(i + dir + tabs.length) % tabs.length]
            selectTab(next, true)
          }
        })
      })
    })()

    document.getElementById('install-copy')?.addEventListener('click', (e) => {
      const btn = e.currentTarget
      navigator.clipboard?.writeText('brew install mydevmachine/tap/devmachine\ndevmachine setup')
      btn.textContent = 'Copied'
      setTimeout(() => {
        btn.textContent = 'Copy'
      }, 1500)
    })

    document.getElementById('agent-prompt-copy')?.addEventListener('click', (e) => {
      const btn = e.currentTarget
      navigator.clipboard?.writeText(
        'Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.',
      )
      btn.textContent = 'Copied'
      setTimeout(() => {
        btn.textContent = 'Copy'
      }, 1500)
    })
  </script>
</BaseLayout>
