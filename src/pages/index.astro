---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
const base = import.meta.env.BASE_URL

const howItWorks = [
  {
    title: 'Connect your server',
    body: 'Run devmachine setup and answer a few questions. It connects to your server and locks it down, so only you can get in.',
    href: `${base}how-it-works/trust-bootstrap/`,
  },
  {
    title: 'A workspace per project',
    body: 'Each project gets its own space on the server, with git, GitHub and Node ready. Open it by name.',
    href: `${base}concepts/machines-and-workspaces/`,
  },
  {
    title: 'Add tools with one command',
    body: 'Claude Code, Docker, your GitHub login. Add one, run devmachine sync, and it is installed.',
    href: `${base}concepts/packages/`,
  },
]

const principles = [
  {
    title: 'Fully open source',
    body: 'All of it is open source. Read it, fork it, change it.',
  },
  {
    title: 'No lock-in',
    body: 'Underneath it is plain Linux, SSH and git. Stop using devmachine and your server still works.',
  },
  {
    title: 'Extensible via packages',
    body: 'Add a tool with one package, or write your own.',
    href: `${base}concepts/packages/`,
  },
  {
    title: 'Your machines, your data',
    body: 'A VPS you rent, a computer you already have, or a virtual machine on your own. Up to you.',
  },
]

const machines = [
  {
    title: 'A VPS',
    body: 'Rent a server with Debian or Ubuntu that you can reach as root over SSH. It is always on, so you can code from anywhere.',
    href: `${base}getting-started/`,
    link: 'Connect your server',
  },
  {
    title: 'A computer you already have',
    body: 'An old laptop, a Linux box sitting idle, a Mac at the office running a Linux virtual machine. Join it to a private network with Tailscale or another VPN, and devmachine reaches it like any server.',
    href: `${base}concepts/reaching-your-server/`,
    link: 'Reach it over a private network',
  },
  {
    title: 'Your own computer, to try',
    body: 'No machine yet? devmachine can make a virtual machine on your computer and set it up exactly like a VPS. Throw it away when you are done.',
    href: `${base}examples/a-local-vm-with-lima/`,
    link: 'Try it on your own computer first',
  },
]

const tiers = [
  { label: 'A few apps', ram: '8 GB RAM', cpu: '2 vCPU', disk: '100 GB disk', body: 'One or two apps and a coding agent.' },
  { label: 'Recommended', ram: '16 GB RAM', cpu: '4 vCPU', disk: '200 GB disk', body: 'Several apps and coding agents at once.' },
  { label: 'Full development', ram: '32 GB RAM', cpu: '8 vCPU', disk: '400 GB disk', body: 'Docker and many intensive apps running together.' },
]
const recommendedTier = 1

const installLines = [
  { cmd: 'brew install mydevmachine/tap/devmachine', comment: '' },
  { cmd: 'devmachine setup', comment: '# connect your server' },
  { cmd: 'devmachine skills add', comment: '# interact from any LLM session with your machine(s)' },
]
const installCmdWidth = Math.max(...installLines.filter((l) => l.comment).map((l) => l.cmd.length)) + 2

const commands = [
  { cmd: 'devmachine setup', desc: 'connect your server and make it safe' },
  { cmd: 'devmachine workspaces new alice', desc: 'add your first workspace' },
  { cmd: 'devmachine sync', desc: 'build it on your server' },
  { cmd: 'devmachine ssh alice', desc: 'open it and start working' },
]

const description =
  'devmachine turns a Debian or Ubuntu server into your own coding machine, with one workspace per project. Free and open source.'
const doc = (path: string, label: string) =>
  `<a class="faq-link" href="${base}${path}">${label} →</a>`
const faq = [
  {
    q: 'Does it log in as root with a password?',
    a: `Only once. <code>setup</code> uses the root password your provider gave you to install a key that only you have, checks that the key works, and then turns password logins off. From then on the server only accepts that key. It also checks the server's fingerprint first, so you know you reached your own server.`,
    link: doc('how-it-works/trust-bootstrap/', 'How setup locks the server'),
  },
  {
    q: 'What is a workspace, and why use one?',
    a: `A workspace is one account on the server for one project, with its own tools, logins and coding agent. Projects do not see each other's files or tokens, one project breaking does not touch the others, and you open any of them by name: <code>devmachine ssh alice</code>.`,
    link: doc('concepts/machines-and-workspaces/', 'Machines and workspaces'),
  },
  {
    q: 'Is it free?',
    a: `Yes. devmachine is free and open source, under the MIT licence. You pay only for the server you rent, or nothing if you use a computer you already have.`,
    link: `<a class="faq-link" href="https://github.com/mydevmachine/devmachine">The code on GitHub →</a>`,
  },
  {
    q: 'Does it only work with Linux?',
    a: `The machines it sets up run Debian or Ubuntu. The CLI itself runs on your computer, macOS or Linux. Your Mac can also be a machine of its own, for the packages made for it.`,
    link: doc('how-it-works/your-computer-as-a-machine/', 'Your computer as a machine'),
  },
  {
    q: 'How do I configure my machine?',
    a: `Ask your coding agent. After <code>devmachine skills add</code>, any Claude Code or Codex session can add packages, workspaces and sites for you. For bigger changes, like writing your own package, open a session in the configuration folder: it holds your whole setup, and a <code>CLAUDE.md</code> there can tell the agent your own rules.`,
    link: doc('day-to-day/', 'Day to day'),
  },
  {
    q: 'Can I use my old laptop?',
    a: `Yes, if it runs Debian or Ubuntu and you can reach it as root over SSH. Set it up from your computer on the same network with <code>devmachine machines add</code>, then add the <code>tailscale</code> package and sign it in with <code>devmachine login tailscale</code>. Put <code>tailscale:&lt;name&gt;</code> first in its addresses, and you reach it from anywhere, even from outside your home.`,
    link: doc('concepts/reaching-your-server/', 'Reaching your server'),
  },
  {
    q: 'Can I use more than one machine?',
    a: `Yes. Add as many as you like with <code>devmachine machines add</code>. Each workspace belongs to one machine, so <code>devmachine ssh alice</code> finds the right one. A command that acts on a whole machine asks you to name it with <code>--machine</code>: it never guesses.`,
    link: doc('how-it-works/choosing-a-target/', 'Choosing a target'),
  },
  {
    q: 'Do I need a domain?',
    a: `No. You need one only to show an app at a public URL with HTTPS. Without one, <code>devmachine tunnel alice 3000</code> opens the app on your own computer, and nothing is published.`,
    link: doc('concepts/publishing/', 'Publishing an app'),
  },
  {
    q: 'What is Ansible?',
    a: `Ansible is a well-known open source tool that installs and configures software on a server from a written description. devmachine uses it underneath, so you never need to learn it. You write Ansible only if you write a package of your own.`,
    link: doc('concepts/packages/', 'Packages'),
  },
  {
    q: 'Where is my configuration?',
    a: `In a folder on your computer, <code>~/.config/devmachine</code>. <code>devmachine config path</code> prints where it is. It holds your machines, workspaces, packages and settings, and nothing personal ever goes into devmachine itself.`,
    link: doc('concepts/configuration/', 'Configuration'),
  },
  {
    q: 'How should I save my configuration?',
    a: `In git. <code>devmachine setup git</code> turns the folder into a repository, and every change the CLI makes becomes a commit. Push it to a private remote to keep a backup and see what changed. Private keys and secrets are never committed.`,
    link: doc('how-it-works/versioning-your-configuration/', 'Versioning your configuration'),
  },
  {
    q: 'What is Tailscale? Does it work with Headscale?',
    a: `Tailscale puts your computer and your servers on a private network of your own, so a server is reachable even when its public address is not. The <code>tailscale</code> package signs in to Tailscale's own service. With Headscale, run <code>tailscale up --login-server</code> on the machine yourself; devmachine only needs the address. Any other VPN works the same way.`,
    link: doc('concepts/reaching-your-server/', 'Reaching your server'),
  },
  {
    q: 'How do I add more packages?',
    a: `<code>devmachine packages list</code> shows what exists. <code>devmachine packages add docker</code> adds one to a machine, <code>--workspace alice</code> adds it to a workspace, and <code>devmachine sync</code> installs it. To make your own, start with <code>devmachine packages new</code>.`,
    link: doc('concepts/packages/', 'Packages'),
  },
  {
    q: 'What happens if I stop using it?',
    a: `Your servers keep working. Underneath it is plain Linux, SSH and git: each workspace is an ordinary account you can still log in to with <code>ssh</code>, and nothing of devmachine runs on the server between commands.`,
    link: doc('concepts/machines-and-workspaces/#the-linux-account', 'The Linux account behind a workspace'),
  },
]

const site = Astro.site?.href ?? 'https://mydevmachine.sh/'
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'devmachine',
    url: site,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'devmachine',
    description,
    url: site,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux',
    license: 'https://github.com/mydevmachine/devmachine/blob/main/LICENSE',
    downloadUrl: 'https://github.com/mydevmachine/devmachine/releases',
    softwareHelp: `${site}getting-started/`,
    image: `${site}og.png`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: ['https://github.com/mydevmachine/devmachine'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/<[^>]+>/g, '').replace(/&lt;/g, '<').replace(/&gt;/g, '>') },
    })),
  },
]
---


<BaseLayout title="devmachine - Code from anywhere." description={description} current="home" jsonLd={jsonLd}>
  <Hero
    eyebrow="Your server, as workspaces"
    headline="Code from anywhere."
    subline="Your own server. One workspace per project. Ready in a few commands."
  />

  <section id="principles" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-16">
    <div class="grid-cards grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((item) => {
          const Tag = item.href ? 'a' : 'div'
          return (
            <Tag href={item.href} class:list={['block p-6', item.href && 'hover:bg-[var(--card)]']}>
              <h3 class="text-lg font-light tracking-tight mb-2">{item.title}</h3>
              <p class="text-sm text-[var(--muted)] leading-relaxed">{item.body}</p>
            </Tag>
          )
        })
      }
    </div>
  </section>

  <section id="before-you-start" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">01 / Before you start</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">First, a machine.</h2>
    <p class="text-[var(--muted)] max-w-2xl mb-10">
      devmachine needs one machine to set up. Pick whichever you have. Your computer reaches it
      through the devmachine CLI, over the internet or over a private network like Tailscale.
    </p>

    <div class="grid-cards grid-cols-1 sm:grid-cols-3">
      {
        machines.map((m, i) => (
          <div class="p-6 flex flex-col">
            <p class="text-xs font-mono text-[var(--muted)] mb-10">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="text-2xl font-light tracking-tight mb-3">{m.title}</h3>
            <p class="text-sm text-[var(--muted)] leading-relaxed mb-4">{m.body}</p>
            <p class="text-sm mt-auto">
              <a href={m.href} class="underline underline-offset-2 hover:text-[var(--ink)]">{m.link} →</a>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="get-started" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">02 / Get started</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-6">Two ways to start.</h2>

    <div>
      <div role="tablist" aria-label="Ways to get started" class="flex border hairline">
        <button
          role="tab"
          id="tab-yourself"
          aria-controls="panel-yourself"
          aria-selected="true"
          tabindex="0"
          class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
        >
          Yourself
        </button>
        <button
          role="tab"
          id="tab-agent"
          aria-controls="panel-agent"
          aria-selected="false"
          tabindex="-1"
          class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
        >
          With your agent
        </button>
      </div>

      <div role="tabpanel" id="panel-yourself" aria-labelledby="tab-yourself" tabindex="0" class="pt-6">
        <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">From your computer, run</p>
        <div class="border hairline bg-[var(--card)] p-4 sm:p-5 relative font-mono text-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <code id="install-cmd" class="min-w-0 whitespace-pre-wrap break-words leading-relaxed">{installLines.map((l) => (<span class="block">{l.cmd}{l.comment && ' '.repeat(installCmdWidth - l.cmd.length)}{l.comment && <span class="text-[var(--muted)]">{l.comment}</span>}</span>))}</code>
            <button
              id="install-copy"
              type="button"
              class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
            >
              Copy
            </button>
          </div>
        </div>
        <p class="text-sm mt-3 text-[var(--muted)]">
          Then make a workspace: <code class="font-mono text-[var(--ink)]">devmachine workspaces new alice && devmachine sync</code>.
          <a href={`${base}getting-started/`} class="underline underline-offset-2 hover:text-[var(--ink)]">
            Getting started →
          </a>
        </p>
      </div>

      <div role="tabpanel" id="panel-agent" aria-labelledby="tab-agent" tabindex="0" class="pt-6" hidden>
        <p class="text-sm text-[var(--muted)] mb-3">
          Paste this into Claude Code, Codex or Cursor. It asks what it needs and does
          the rest; you only run <code class="font-mono text-[var(--ink)]">devmachine setup</code> yourself.
        </p>
        <div class="border hairline bg-[var(--card)] p-4 sm:p-5 font-mono text-sm">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <code id="agent-prompt" class="min-w-0 break-all">Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.</code>
            <button
              id="agent-prompt-copy"
              type="button"
              class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
            >
              Copy
            </button>
          </div>
        </div>
        <p class="text-sm mt-3">
          <a href={`${base}agent-setup/`} class="underline underline-offset-2 text-[var(--muted)] hover:text-[var(--ink)]">
            Read what it will do
          </a>
        </p>
        <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mt-3">
          For LLMs:
          <a href={`${base}llms.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms.txt</a>
          ·
          <a href={`${base}llms-full.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms-full.txt</a>
        </p>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="dark-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">03 / How it works</p>
      <div class="grid grid-cols-1 gap-6 min-[900px]:grid-cols-2 min-[900px]:gap-12 mb-12">
        <h2 class="text-3xl sm:text-4xl font-light tracking-tight">Three ideas, in order.</h2>
        <p class="text-[#9a9a9a] max-w-2xl">
          One command connects the server. One command makes a workspace.
          One command adds a tool to it.
        </p>
      </div>
      <div class="grid-cards grid-cols-1 sm:grid-cols-3">
        {
          howItWorks.map((item, i) => (
            <a href={item.href} class="block p-6 hover:bg-white/5">
              <p class="text-xs font-mono text-[#9a9a9a] mb-10">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="text-2xl font-light tracking-tight mb-3">{item.title}</h3>
              <p class="text-sm text-[#9a9a9a] leading-relaxed">{item.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="first-commands" class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-10">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">04 / First commands</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-10">Four commands.</h2>
    <div class="grid grid-cols-1 gap-4">
      {
        commands.map((c) => (
          <div class="border hairline p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-6">
            <div class="overflow-x-auto">
              <code class="font-mono text-sm whitespace-nowrap block">{c.cmd}</code>
            </div>
            <p class="text-sm text-[var(--muted)] sm:text-right shrink-0">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </section>


  <section id="see-it-work" class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">05 / See it work</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">Ask. It is live.</h2>
    <p class="text-[var(--muted)] max-w-2xl mb-10">
      Tell your coding agent what you want. It runs the commands, and your app is online with HTTPS.
    </p>

    <div class="demo-grid">
      <div class="demo-col">
        <div class="terminal">
          <div class="terminal-titlebar">
            <span class="terminal-dot" />
            <span class="terminal-dot" />
            <span class="terminal-dot" />
            <span class="terminal-title font-mono">claude — ~/app</span>
          </div>
          <div class="terminal-body font-mono demo-terminal-body" id="demo-term-body"></div>
        </div>
      </div>

      <div class="demo-col demo-chain-col">
        <div class="demo-chain" id="demo-chain">
          <div class="demo-node" data-node="dns">
            <div class="demo-node-dot"></div>
            <p class="demo-node-label">DNS</p>
            <p class="demo-node-value">A&nbsp; app.example.com &rarr; 203.0.113.10</p>
          </div>
          <div class="demo-link" data-link="dns-caddy"><span class="demo-packet"></span></div>
          <div class="demo-node" data-node="caddy">
            <div class="demo-node-dot"></div>
            <p class="demo-node-label">Caddy</p>
            <p class="demo-node-value">app.example.com &rarr; localhost:3000 &middot; HTTPS</p>
          </div>
          <div class="demo-link" data-link="caddy-ws"><span class="demo-packet"></span></div>
          <div class="demo-node" data-node="workspace">
            <div class="demo-node-dot"></div>
            <p class="demo-node-label">Workspace alice</p>
            <p class="demo-node-value">:3000</p>
          </div>
        </div>
      </div>

      <div class="demo-col">
        <div class="demo-browser">
          <div class="demo-browser-bar">
            <span class="demo-browser-dot"></span>
            <span class="demo-browser-dot"></span>
            <span class="demo-browser-dot"></span>
            <div class="demo-browser-address">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="5" y="11" width="14" height="9" rx="1.5" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              <span>https://app.example.com</span>
            </div>
          </div>
          <div class="demo-browser-viewport">
            <p class="demo-browser-empty" id="demo-browser-empty">Waiting for it to publish&hellip;</p>
            <div class="demo-browser-site" id="demo-browser-site">
              <div class="acme-site">
                <div class="acme-nav">
                  <span class="acme-logo">Acme</span>
                  <div class="acme-nav-links">
                    <span>Product</span>
                    <span>Pricing</span>
                    <span>Sign in</span>
                  </div>
                </div>
                <div class="acme-hero">
                  <h1>Acme handles the busywork.</h1>
                  <p>Your team, minus the spreadsheets.</p>
                  <span class="acme-cta">Get started</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <button type="button" id="demo-replay" class="text-xs uppercase tracking-wide px-3 py-1 border hairline" hidden>
        Replay
      </button>
    </div>
  </section>

  <section id="measure-your-needs" class="dark-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-28 pb-32">
    <p class="text-xs font-mono uppercase tracking-widest text-[#9a9a9a] mb-3">06 / Requirements</p>
    <div class="grid grid-cols-1 gap-6 min-[900px]:grid-cols-2 min-[900px]:gap-12 mb-10">
      <h2 class="text-3xl sm:text-4xl font-light tracking-tight">Measure your needs.</h2>
      <p class="text-[#9a9a9a] max-w-2xl">
        Rent what you need, not more. Count how many apps and coding agents you will run at the
        same time, pick the size below, and move up later if it gets slow. A computer you
        already have works too, if it runs Debian or Ubuntu.
      </p>
    </div>
    <div id="sizing" class="border hairline p-6 mb-4">
      <label for="sizing-range" class="sr-only">How much will you run on the server?</label>
      <input
        id="sizing-range"
        type="range"
        min="0"
        max={tiers.length - 1}
        step="1"
        value={recommendedTier}
        aria-valuetext={tiers[recommendedTier].label}
        class="w-full accent-[#5aa9e6] cursor-pointer"
      />
      <div class="grid grid-cols-3 text-xs font-mono uppercase tracking-wide mt-2">
        {
          tiers.map((tier, i) => (
            <button
              type="button"
              data-tier={i}
              class:list={[
                'sizing-label py-1',
                i === 0 && 'text-left',
                i === 1 && 'text-center',
                i === 2 && 'text-right',
                i === recommendedTier ? 'text-[#5aa9e6]' : 'text-[#9a9a9a]',
              ]}
            >
              {tier.label}
            </button>
          ))
        }
      </div>
      {
        tiers.map((tier, i) => (
          <div data-tier-panel={i} hidden={i !== recommendedTier} class="mt-6" aria-live="polite">
            <p class="text-2xl sm:text-3xl font-light tracking-tight mb-1">{tier.ram}</p>
            <p class="text-sm font-mono text-[#9a9a9a] mb-3">{tier.cpu} · {tier.disk} · Debian or Ubuntu</p>
            <p class="text-sm text-[#9a9a9a] leading-relaxed">{tier.body}</p>
          </div>
        ))
      }
    </div>
    <p class="text-xs text-[#9a9a9a]">
      Any Debian or Ubuntu VPS works.
      No VPS yet?
      <a
        href="https://www.hostinger.com/br?REFERRALCODE=MYDEVMACHINE"
        target="_blank"
        rel="noopener sponsored"
        class="underline underline-offset-2 hover:text-white"
      >
        See the Hostinger deals →
      </a>
    </p>
    </div>
  </section>

  <section id="faq" class="max-w-6xl mx-auto px-4 sm:px-6 pt-20 pb-20">
    <div class="grid grid-cols-1 min-[900px]:grid-cols-[minmax(0,20rem)_1fr] gap-10 min-[900px]:gap-16">
      <div class="min-[900px]:sticky min-[900px]:top-24 min-[900px]:self-start">
        <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">07 / FAQ</p>
        <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">Questions, answered.</h2>
        <p class="text-[var(--muted)] max-w-sm mb-4">
          Short answers to what people ask before they start.
        </p>
        <a href={`${base}troubleshooting/`} class="text-sm underline underline-offset-2 hover:text-[var(--ink)]">
          More in the troubleshooting guide &rarr;
        </a>
      </div>

      <div>
        {
          faq.map((item, i) => (
            <details class="faq-item" name="faq">
              <summary class="faq-summary">
                <span class="faq-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-question">{item.q}</span>
                <span class="faq-icon" aria-hidden="true" />
              </summary>
              <div class="faq-answer-wrap">
                <div class="faq-answer-inner">
                  <div class="faq-answer"><p set:html={item.a} /><p class="faq-more" set:html={item.link} /></div>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="read-the-docs" class="max-w-6xl mx-auto px-4 sm:px-6 pt-28 pb-32 text-center">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">08 / Documentation</p>
    <h2 class="text-3xl sm:text-5xl font-light tracking-tight mb-5">Everything is written down.</h2>
    <p class="text-[var(--muted)] max-w-xl mx-auto mb-10">
      How each command works, why it works that way, and what to do when something fails.
      Plain words, real examples.
    </p>
    <a
      href={`${base}getting-started/`}
      class="inline-block border border-[var(--ink)] px-10 py-4 text-base font-mono uppercase tracking-wide hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors"
    >
      Read the documentation →
    </a>
  </section>

  <script is:inline>
    ;(() => {
      const tabs = Array.from(document.querySelectorAll('#get-started [role="tab"]'))
      if (!tabs.length) return

      function selectTab(tab, focus) {
        for (const t of tabs) {
          const selected = t === tab
          t.setAttribute('aria-selected', String(selected))
          t.tabIndex = selected ? 0 : -1
          const panel = document.getElementById(t.getAttribute('aria-controls'))
          if (panel) panel.hidden = !selected
        }
        if (focus) tab.focus()
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => selectTab(tab, false))
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault()
            const dir = e.key === 'ArrowRight' ? 1 : -1
            const next = tabs[(i + dir + tabs.length) % tabs.length]
            selectTab(next, true)
          }
        })
      })
    })()

    ;(() => {
      const range = document.getElementById('sizing-range')
      if (!range) return
      const labels = Array.from(document.querySelectorAll('#sizing .sizing-label'))
      const panels = Array.from(document.querySelectorAll('#sizing [data-tier-panel]'))

      function show(index) {
        range.value = String(index)
        range.setAttribute('aria-valuetext', labels[index]?.textContent.trim() ?? '')
        labels.forEach((label, i) => {
          label.classList.toggle('text-[#5aa9e6]', i === index)
          label.classList.toggle('text-[#9a9a9a]', i !== index)
        })
        panels.forEach((panel, i) => {
          panel.hidden = i !== index
        })
      }

      range.addEventListener('input', () => show(Number(range.value)))
      labels.forEach((label, i) => label.addEventListener('click', () => show(i)))
    })()

    document.getElementById('install-copy')?.addEventListener('click', (e) => {
      const btn = e.currentTarget
      navigator.clipboard?.writeText(
        'brew install mydevmachine/tap/devmachine\ndevmachine setup\ndevmachine skills add',
      )
      btn.textContent = 'Copied'
      setTimeout(() => {
        btn.textContent = 'Copy'
      }, 1500)
    })

    document.getElementById('agent-prompt-copy')?.addEventListener('click', (e) => {
      const btn = e.currentTarget
      navigator.clipboard?.writeText(
        'Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.',
      )
      btn.textContent = 'Copied'
      setTimeout(() => {
        btn.textContent = 'Copy'
      }, 1500)
    })

    ;(() => {
      const section = document.getElementById('see-it-work')
      const body = document.getElementById('demo-term-body')
      const emptyState = document.getElementById('demo-browser-empty')
      const site = document.getElementById('demo-browser-site')
      const replayBtn = document.getElementById('demo-replay')
      if (!section || !body || !replayBtn) return

      const nodes = {
        dns: document.querySelector('[data-node="dns"]'),
        caddy: document.querySelector('[data-node="caddy"]'),
        workspace: document.querySelector('[data-node="workspace"]'),
      }
      const links = {
        dnsToCaddy: document.querySelector('[data-link="dns-caddy"]'),
        caddyToWs: document.querySelector('[data-link="caddy-ws"]'),
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function line(cls, text) {
        const el = document.createElement('div')
        el.className = `term-line ${cls}`
        el.textContent = text
        return el
      }

      function bulletLine(cls, text) {
        const el = document.createElement('div')
        el.className = `term-line ${cls}`
        const marker = document.createElement('span')
        marker.className = 'term-agent-marker'
        marker.textContent = '● '
        el.append(marker, document.createTextNode(text))
        return el
      }

      function promptLine(text) {
        const el = document.createElement('div')
        el.className = 'term-line term-agent-prompt'
        el.textContent = text
        return el
      }

      const steps = [
        { append: () => promptLine('> publish port 3000 of alice at app.example.com'), delay: 700 },
        { append: () => bulletLine('term-agent-reply', "I'll publish it with the devmachine CLI."), delay: 500 },
        {
          append: () => bulletLine('term-agent-tool', 'Bash(devmachine expose add alice 3000 --host app.example.com --publish)'),
          delay: 600,
        },
        {
          append: () =>
            line(
              'term-out',
              "recorded https://app.example.com -> alice:3000 in the configuration. Run devmachine sync to publish it on main.",
            ),
          delay: 500,
          after: () => setActive(nodes.dns),
        },
        { append: () => bulletLine('term-agent-tool', 'Bash(devmachine sync --yes)'), delay: 600 },
        { append: () => line('term-out', 'TASK [routes from the configuration]'), delay: 300 },
        {
          append: () => line('term-out', 'changed: [main]'),
          delay: 400,
          after: () => setActive(nodes.caddy, links.dnsToCaddy),
        },
        { append: () => line('term-out', 'TASK [reload caddy for the routes]'), delay: 300 },
        { append: () => line('term-out', 'changed: [main]'), delay: 400 },
        { append: () => line('term-out', 'main: ok=42 changed=2 failed=0'), delay: 600 },
        {
          append: () => bulletLine('term-agent-result', 'Done. https://app.example.com is live, with HTTPS.'),
          delay: 0,
          after: () => {
            setActive(nodes.workspace, links.caddyToWs)
            showSite()
          },
        },
      ]

      function setActive(node, link) {
        if (link) link.classList.add('is-active')
        if (node) node.classList.add('is-active')
      }

      function showSite() {
        if (emptyState) emptyState.style.opacity = '0'
        if (site) site.classList.add('is-visible')
      }

      function reset() {
        body.innerHTML = ''
        Object.values(nodes).forEach((n) => n?.classList.remove('is-active'))
        Object.values(links).forEach((l) => l?.classList.remove('is-active'))
        if (emptyState) emptyState.style.opacity = '1'
        if (site) site.classList.remove('is-visible')
        replayBtn.hidden = true
      }

      let pending = null

      function schedule(fn, delay) {
        const start = Date.now()
        pending = { fn, delay, start }
        pending.id = setTimeout(() => {
          pending = null
          fn()
        }, delay)
      }

      document.addEventListener('visibilitychange', () => {
        if (!pending) return
        if (document.hidden) {
          clearTimeout(pending.id)
          pending.remaining = pending.delay - (Date.now() - pending.start)
        } else if (pending.remaining !== undefined) {
          const { fn, remaining } = pending
          pending.start = Date.now()
          pending.delay = Math.max(remaining, 0)
          pending.id = setTimeout(() => {
            pending = null
            fn()
          }, pending.delay)
        }
      })

      function playFinalState() {
        reset()
        for (const step of steps) body.appendChild(step.append())
        setActive(nodes.dns)
        setActive(nodes.caddy, links.dnsToCaddy)
        setActive(nodes.workspace, links.caddyToWs)
        showSite()
        replayBtn.hidden = false
      }

      function playSequence(i) {
        if (i >= steps.length) {
          replayBtn.hidden = false
          return
        }
        const step = steps[i]
        body.appendChild(step.append())
        body.scrollTop = body.scrollHeight
        step.after?.()
        schedule(() => playSequence(i + 1), step.delay)
      }

      function play() {
        reset()
        if (reduceMotion) {
          playFinalState()
          return
        }
        playSequence(0)
      }

      replayBtn.addEventListener('click', play)

      let played = false
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !played) {
              played = true
              play()
              observer.disconnect()
            }
          }
        },
        { threshold: 0.35 },
      )
      observer.observe(section)
    })()
  </script>
</BaseLayout>
